---
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer class="bg-stone px-[6%] pt-20 text-cream/55">
  <div class="mx-auto grid max-w-[1280px] gap-12 md:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
    <div>
      <div class="font-serif text-2xl text-cream/90">
        {site.brand.pre}<span class="text-gold-lt">{site.brand.post}</span>
      </div>
      <div class="mt-1 font-sans text-[9px] font-medium uppercase tracking-label text-cream/35">{site.tagline}</div>
      <p class="mt-5 max-w-xs font-sans text-[13px] font-light leading-relaxed">
        Ganzheitliche Therapie, Training und Coaching — kompetent, persönlich und individuell auf Sie abgestimmt.
      </p>
    </div>

    <div>
      <h4 class="mb-4 font-sans text-[10px] font-semibold uppercase tracking-label text-cream/45">Leistungen</h4>
      <a class="block py-1 font-sans text-[13px] font-light transition-colors hover:text-cream/95" href="/therapie">Therapie</a>
      <a class="block py-1 font-sans text-[13px] font-light transition-colors hover:text-cream/95" href="/training">Training</a>
      <a class="block py-1 font-sans text-[13px] font-light transition-colors hover:text-cream/95" href="/coaching">Coaching</a>
    </div>

    <div>
      <h4 class="mb-4 font-sans text-[10px] font-semibold uppercase tracking-label text-cream/45">Praxis</h4>
      <a class="block py-1 font-sans text-[13px] font-light transition-colors hover:text-cream/95" href="/ueber-uns">Über uns</a>
      <a class="block py-1 font-sans text-[13px] font-light transition-colors hover:text-cream/95" href="/team">Team</a>
      <a class="block py-1 font-sans text-[13px] font-light transition-colors hover:text-cream/95" href="/standorte">Standorte</a>
      <a class="block py-1 font-sans text-[13px] font-light transition-colors hover:text-cream/95" href="/karriere">Karriere</a>
    </div>

    <div>
      <h4 class="mb-4 font-sans text-[10px] font-semibold uppercase tracking-label text-cream/45">Kontakt</h4>
      <a class="block py-1 font-sans text-[13px] font-light transition-colors hover:text-cream/95" href={`tel:${site.phonePlain}`}>{site.phone}</a>
      <a class="block py-1 font-sans text-[13px] font-light transition-colors hover:text-cream/95" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="block py-1 font-sans text-[13px] font-light transition-colors hover:text-cream/95" href="/impressum">Impressum</a>
      <a class="block py-1 font-sans text-[13px] font-light transition-colors hover:text-cream/95" href="/datenschutz">Datenschutz</a>
    </div>
  </div>

  <div class="mx-auto mt-14 flex max-w-[1280px] flex-wrap items-center justify-between gap-2 border-t border-cream/10 py-6 font-sans text-[11px] font-light text-cream/40">
    <span>&copy; {year} {site.legalName}</span>
    <span>
      <a class="transition-colors hover:text-cream/95" href="/impressum">Impressum</a>
      &middot;
      <a class="transition-colors hover:text-cream/95" href="/datenschutz">Datenschutz</a>
    </span>
  </div>
</footer>
