---
import Eyebrow from './Eyebrow.astro';
interface Props { eyebrow?: string; title: string; sub?: string; }
const { eyebrow, title, sub } = Astro.props;
---
<section class="border-b border-line bg-cream px-[8%] pb-16 pt-20 text-center">
  {eyebrow && <Eyebrow center class="mb-5">{eyebrow}</Eyebrow>}
  <h1 class="font-serif text-ink" style="font-size:clamp(2.5rem,5.4vw,4.25rem);line-height:1.04" set:html={title} />
  {sub && <p class="lede mx-auto mt-5" set:html={sub} />}
</section>
