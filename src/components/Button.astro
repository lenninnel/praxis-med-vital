---
import { withBase } from '../lib/base';
type Variant = 'primary' | 'ghost' | 'outline';
interface Props {
  href?: string;
  variant?: Variant;
  class?: string;
  type?: 'button' | 'submit';
  arrow?: boolean;
}
const { href, variant = 'primary', class: cls = '', type = 'button', arrow = false } = Astro.props;

const base = 'group inline-flex items-center justify-center font-sans transition-all duration-300 ease-smooth';

const styles: Record<Variant, string> = {
  primary:
    'gap-2.5 rounded-btn bg-gold px-8 py-4 text-[11px] font-semibold uppercase tracking-label text-white hover:bg-gold-dk',
  outline:
    'gap-2.5 rounded-btn border border-ink/25 px-7 py-3.5 text-[11px] font-semibold uppercase tracking-label text-ink hover:bg-ink hover:text-cream hover:border-ink',
  ghost:
    'gap-2 pb-1 text-[11px] font-semibold uppercase tracking-label text-ink border-b border-gold hover:text-gold',
};

const Tag = href ? 'a' : 'button';
---
<Tag
  class={`${base} ${styles[variant]} ${cls}`}
  {...href ? { href: withBase(href) } : { type }}
>
  <slot />
  {arrow && (
    <span aria-hidden="true" class="transition-transform duration-300 ease-smooth group-hover:translate-x-1">→</span>
  )}
</Tag>
