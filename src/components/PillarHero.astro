---
import Reveal from './Reveal.tsx';
import Eyebrow from './Eyebrow.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
interface Benefit { title: string; text: string; }
interface Props {
  label: string;
  kicker: string;
  intro: string;
  benefits: Benefit[];
  imageLabel?: string;
  image?: string | null;
}
const { label, kicker, intro, benefits, imageLabel = 'Foto', image = null } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="grid gap-14 md:grid-cols-[1.05fr_0.95fr] md:items-center">
      <Reveal client:load>
        <Eyebrow class="mb-5">{label}</Eyebrow>
        <h1 class="font-serif text-display text-ink">{label}</h1>
        <p class="mt-3 font-serif text-2xl italic text-gold">{kicker}</p>
        <p class="lede mt-6">{intro}</p>
        <div class="mt-9 space-y-6">
          {benefits.map((b) => (
            <div class="flex items-start gap-4">
              <span class="mt-2.5 h-px w-6 flex-shrink-0 bg-gold"></span>
              <div>
                <p class="font-sans text-[14px] font-semibold uppercase tracking-[0.08em] text-ink">{b.title}</p>
                <p class="mt-0.5 font-sans text-[13px] font-light leading-relaxed text-ink-mid">{b.text}</p>
              </div>
            </div>
          ))}
        </div>
      </Reveal>
      <Reveal client:visible>
        <div class="overflow-hidden rounded-card">
          <ImagePlaceholder src={image} ratio="4 / 5" rounded={false} label={imageLabel} sublabel="folgt in Kürze" alt={label} class="w-full transition-transform duration-[1200ms] ease-smooth hover:scale-[1.03]" />
        </div>
      </Reveal>
    </div>
  </div>
</section>
