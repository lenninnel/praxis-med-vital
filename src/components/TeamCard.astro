---
import ImagePlaceholder from './ImagePlaceholder.astro';
import { withBase } from '../lib/base';
interface Props {
  id: string;
  name: string;
  role?: string;
  qualification?: string;
  bio?: string;
  tags?: string[];
  initials: string;
  photo?: string | null;
  href?: string;
}
const { id, name, role, qualification, bio, tags = [], initials, photo = null, href } = Astro.props;
const link = href ?? `/team/${id}`;
const sub = [qualification, role].filter(Boolean).join(' · ');
---
<a href={withBase(link)} class="group block">
  <div class="overflow-hidden rounded-card border border-line bg-cream-dk">
    <ImagePlaceholder src={photo} ratio="4 / 5" rounded={false} label={initials} sublabel="Porträt folgt" alt={name} />
  </div>
  <div class="pt-5">
    <h3 class="font-serif text-2xl text-ink transition-colors group-hover:text-gold">{name}</h3>
    {sub && <p class="mt-1 font-sans text-[10px] font-semibold uppercase tracking-label text-gold">{sub}</p>}
    {bio && <p class="mt-3 font-sans text-[13px] font-light leading-relaxed text-ink-mid">{bio}</p>}
    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <span class="rounded-pill border border-parchment px-2.5 py-1 font-sans text-[9px] font-medium uppercase tracking-[0.1em] text-ink-mid">{t}</span>
        ))}
      </div>
    )}
  </div>
</a>
