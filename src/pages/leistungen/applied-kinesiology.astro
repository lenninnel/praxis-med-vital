---
import Layout from '../../layouts/Layout.astro';

const anwendungen = [
  'Wiederkehrende Gelenkbeschwerden (Fußfehlstellungen, Zahnstörfelder, Bissfehlstellungen, alte Traumata)',
  'Rückenschmerzen (Operationsnarben, alte Traumata, gastrointestinale Störungen, kraniomandibuläre Ursachen)',
  'Unklare abdominelle Beschwerden (Dysbiosen, Nahrungsmittelunverträglichkeiten, Narbenstörfelder)',
  'Chronische Infektionen (Zahnstörfelder, Impfnarben, Schwermetallbelastungen)',
  'Chronisches Müdigkeitssyndrom und Erschöpfung nach viralen Infektionen',
  'Kopfschmerzsyndrome (alte Traumata, Histaminunverträglichkeiten, CMD, Schwermetallbelastungen)',
];
---

<Layout title="Applied Kinesiology – Praxis Med Vital" description="Applied Kinesiology: ganzheitliche Untersuchung und Therapie auf Basis manueller Muskeltests — nur von Therapeuten mit staatlich anerkanntem Diplom.">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Spezialisierung</span>
      <h1>Applied Kinesiology</h1>
      <p>Ganzheitliche Diagnose- und Behandlungsmethode auf Basis manueller Muskeltests.</p>
    </div>
  </section>

  <section class="sec sec--cream reveal">
    <div class="container" style="max-width:760px;margin:0 auto">
      <a href="/leistungen#spezialisierung" class="back-link" style="margin-bottom:40px">← Zurück zu Spezialisierung</a>

      <p class="detail-lead" style="margin-top:24px">
        Applied Kinesiology ist eine ganzheitliche Untersuchungs- und Therapiemethode, die auf der manuellen Testung von Muskeln basiert. Sie ermöglicht die strategische Suche nach Auslösern für immer wiederkehrende Beschwerden — häufig liegt die Ursache fernab vom Symptom.
      </p>

      <h2 class="detail-h2">Wie funktioniert es?</h2>
      <p class="detail-body">
        Die Grundlage bilden spezifische Muskeltests, die die Funktion der Muskeln und der neuromuskulären Feedbackschleife untersuchen. Funktionsänderungen durch diagnostische Reize stellen den Schlüssel der diagnostischen Prozesse dar. So können Zusammenhänge zwischen verschiedenen medizinischen Fachgebieten hergestellt und eine individuell optimierte, nachhaltige Therapie eingeleitet werden.
      </p>

      <aside class="detail-hinweis">
        <span class="detail-hinweis__label">Wichtiger Hinweis</span>
        <p>Die AK wird nur von Personen mit einem staatlich anerkannten therapeutischen Diplom gelehrt und unterscheidet sich so von Formen der Laien-Kinesiologie.</p>
      </aside>

      <h2 class="detail-h2">Anwendungsbeispiele</h2>
      <ul class="detail-list">
        {anwendungen.map((a) => (
          <li>{a}</li>
        ))}
      </ul>

      <div class="detail-cta">
        <a href="/kontakt" class="btn-primary">Termin anfragen</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .detail-lead {
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 400;
    line-height: 1.45;
    color: var(--ink);
    padding-left: 24px;
    border-left: 0.5px solid var(--gold);
  }

  .detail-h2 {
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 400;
    color: var(--ink);
    margin-top: 56px;
    margin-bottom: 18px;
    line-height: 1.15;
  }

  .detail-body {
    font-family: var(--ff-sans);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.85;
    color: var(--ink-mid);
  }

  .detail-hinweis {
    margin-top: 48px;
    padding: 28px 32px;
    background: var(--white);
    border: 0.5px solid var(--border);
    border-left: 2px solid var(--gold);
  }

  .detail-hinweis__label {
    display: block;
    font-family: var(--ff-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 12px;
  }

  .detail-hinweis p {
    font-family: var(--ff-sans);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.75;
    color: var(--ink);
  }

  .detail-list {
    list-style: none;
    padding: 0;
    margin-top: 18px;
  }

  .detail-list li {
    position: relative;
    padding: 16px 0 16px 32px;
    font-family: var(--ff-sans);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.65;
    color: var(--ink-mid);
    border-bottom: 0.5px solid var(--border);
  }

  .detail-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 27px;
    width: 18px;
    height: 0.5px;
    background: var(--gold);
  }

  .detail-list li:last-child { border-bottom: 0; }

  .detail-cta {
    margin-top: 56px;
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    align-items: center;
  }
</style>
