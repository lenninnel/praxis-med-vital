---
import Layout from '../../layouts/Layout.astro';
import leistungen from '../../data/leistungen.json';

const { kategorien, behandlungszeit } = leistungen;
const behzeitNum = behandlungszeit ? behandlungszeit.replace(/\s*Minuten?\s*$/i, '').trim() : '';
---

<Layout title="Behandlungsfelder – Praxis Med Vital" description="Drei Behandlungsfelder, ein Ziel — Orthopädie, Neurologie und zertifizierte Spezialmethoden.">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Leistungen</span>
      <h1>Behandlungsfelder</h1>
      <p>Drei Behandlungsfelder, ein Ziel — Ihre Gesundheit und Mobilität.</p>
    </div>
  </section>

  <section class="sec sec--cream reveal">
    <div class="container">
      <div class="leistung-grid">
        {kategorien.map((kat: any) => (
          <article class="leistung-card" id={kat.id}>
            <span class="leistung-card__num">{kat.num}</span>
            <h2 class="leistung-card__title">{kat.titel}</h2>
            <p class="leistung-card__desc">{kat.beschreibung}</p>
            <ul class="leistung-card__items">
              {kat.leistungen.map((l: any) => (
                <li>
                  {l.detail ? (
                    <a href={import.meta.env.BASE_URL + l.detail.replace(/^\//, "")} class="leistung-card__link">{l.name} →</a>
                  ) : (
                    <span>{l.name}</span>
                  )}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      {behzeitNum && (
        <aside class="behzeit-box">
          <span class="behzeit-box__num">{behzeitNum}</span>
          <span class="behzeit-box__label">Minuten Behandlungszeit</span>
          <p class="behzeit-box__note">
            Alle Spezialleistungen als Privat- oder Selbstzahler buchbar — ohne ärztliche Überweisung.
          </p>
        </aside>
      )}
    </div>
  </section>

  <section class="sec sec--ink reveal">
    <div class="container text-center">
      <span class="eyebrow">Termin</span>
      <h2 class="section-title">Bereit für Ihre Behandlung?</h2>
      <p class="section-sub">
        Vereinbaren Sie unkompliziert einen Termin — telefonisch oder per Formular.
      </p>
      <a href={`${import.meta.env.BASE_URL}kontakt`} class="btn-primary" style="margin-top:36px">Termin anfragen</a>
    </div>
  </section>
</Layout>

<style>
  .leistung-card__link {
    display: inline-block;
    color: var(--ink-mid);
    transition: color .2s;
  }
  .leistung-card__link:hover { color: var(--gold); }

  .behzeit-box {
    margin-top: 56px;
    background: var(--ink);
    padding: 48px 56px;
    color: var(--cream);
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    border: 0.5px solid var(--ink);
  }

  .behzeit-box__num {
    display: block;
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: 80px;
    font-weight: 400;
    color: var(--cream);
    line-height: 1;
  }

  .behzeit-box__label {
    display: block;
    margin-top: 12px;
    font-family: var(--ff-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--gold-lt);
  }

  .behzeit-box__note {
    margin-top: 20px;
    font-family: var(--ff-sans);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(245, 240, 232, 0.6);
    max-width: 480px;
    margin-inline: auto;
  }
</style>
