---
import Layout from '../../layouts/Layout.astro';
import leistungen from '../../data/leistungen.json';

const { kategorien, behandlungszeit } = leistungen;
---

<Layout title="Behandlungsfelder – Praxis Med Vital" description="Drei Behandlungsfelder, ein Ziel — Orthopädie, Neurologie und zertifizierte Spezialmethoden.">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Leistungen</span>
      <h1>Behandlungsfelder</h1>
      <p>Drei Behandlungsfelder, ein Ziel — Ihre Gesundheit und Mobilität.</p>
    </div>
  </section>

  <section class="sec reveal">
    <div class="container">
      <div class="accordion">
        {kategorien.map((kat: any, idx: number) => (
          <article class:list={["acc-item", { "is-open": idx === 0 }]} id={kat.id}>
            <button
              class="acc-head"
              type="button"
              aria-expanded={idx === 0 ? "true" : "false"}
              aria-controls={`panel-${kat.id}`}
            >
              <span class="acc-head__num" aria-hidden="true">{kat.num}</span>
              <span class="acc-head__titel">{kat.titel}</span>
              <span class="acc-head__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="4 7 9 12 14 7"/>
                </svg>
              </span>
            </button>

            <div
              class="acc-panel"
              id={`panel-${kat.id}`}
              role="region"
              aria-labelledby={`head-${kat.id}`}
            >
              <div class="acc-panel__inner">
                <p class="acc-panel__desc">{kat.beschreibung}</p>
                <ul class="acc-list">
                  {kat.leistungen.map((l: any) => (
                    <li class="acc-list__item">
                      <h3 class="acc-list__name">{l.name}</h3>
                      <p class="acc-list__desc">{l.desc}</p>
                      {l.detail && (
                        <a href={l.detail} class="acc-list__link">Mehr erfahren →</a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--g900 reveal">
    <div class="container text-center">
      <span class="eyebrow">Behandlungszeit</span>
      <hr class="rule" style="margin-inline:auto"/>
      <p class="behandlungszeit">{behandlungszeit}</p>
      <p class="behandlungszeit__note">
        Alle Leistungen auf ärztliche Verordnung oder als Selbstzahler buchbar.
      </p>
      <a href="/kontakt" class="btn-primary" style="margin-top:32px">Termin anfragen</a>
    </div>
  </section>
</Layout>

<style>
  .accordion {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 960px;
    margin: 0 auto;
  }

  .acc-item {
    background: var(--white);
    border-radius: 6px;
    overflow: hidden;
  }

  .acc-head {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
    padding: 32px 40px;
    border: 1px solid var(--border);
    border-left: 3px solid transparent;
    border-radius: 6px;
    background: var(--white);
    text-align: left;
    cursor: pointer;
    transition: border-color .3s, background .3s;
    font-family: inherit;
  }

  .acc-head:hover {
    border-color: var(--g100);
  }

  .acc-item.is-open .acc-head {
    border-left-color: var(--amber);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-color: transparent;
  }

  .acc-head__num {
    font-family: var(--ff-serif);
    font-size: 56px;
    font-weight: 700;
    color: var(--g50);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .acc-head__titel {
    font-family: var(--ff-serif);
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 600;
    color: var(--g900);
    line-height: 1.2;
  }

  .acc-head__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--g50);
    color: var(--g900);
    transition: transform .35s ease, background .3s, color .3s;
  }

  .acc-item.is-open .acc-head__icon {
    transform: rotate(180deg);
    background: var(--amber);
    color: var(--white);
  }

  .acc-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height .45s ease;
    background: var(--cream);
    border: 1px solid var(--border);
    border-top: 0;
    border-left-width: 3px;
    border-left-color: transparent;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
  }

  .acc-item.is-open .acc-panel {
    border-left-color: var(--amber);
  }

  .acc-panel__inner {
    padding: 36px 40px 40px;
  }

  .acc-panel__desc {
    font-size: 15px;
    font-weight: 300;
    color: var(--ink-mid);
    line-height: 1.7;
    max-width: 640px;
    margin-bottom: 28px;
  }

  .acc-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 40px;
  }

  .acc-list__item {
    position: relative;
    padding-left: 26px;
  }

  .acc-list__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 12px;
    width: 16px;
    height: 1px;
    background: var(--amber);
  }

  .acc-list__name {
    font-family: var(--ff-sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--g900);
    line-height: 1.35;
    margin-bottom: 4px;
  }

  .acc-list__desc {
    font-size: 13px;
    font-weight: 300;
    color: var(--ink-lt);
    line-height: 1.6;
  }

  .acc-list__link {
    display: inline-block;
    margin-top: 8px;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: .04em;
    color: var(--amber);
    transition: color .2s;
  }

  .acc-list__link:hover { color: var(--amber-dk); }

  .behandlungszeit {
    font-family: var(--ff-serif);
    font-size: clamp(44px, 6.5vw, 80px);
    font-weight: 600;
    color: var(--amber);
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin-top: 24px;
  }

  .behandlungszeit__note {
    font-size: 15px;
    font-weight: 300;
    color: rgba(255,255,255,.65);
    line-height: 1.7;
    max-width: 520px;
    margin: 18px auto 0;
  }

  @media (max-width: 700px) {
    .acc-head { padding: 24px 24px; gap: 18px; }
    .acc-head__num { font-size: 40px; }
    .acc-panel__inner { padding: 28px 24px 32px; }
    .acc-list { grid-template-columns: 1fr; gap: 20px; }
  }
</style>

<script is:inline>
  (function () {
    const items = document.querySelectorAll('.acc-item');

    function setMaxHeight(panel, open) {
      if (open) {
        panel.style.maxHeight = panel.scrollHeight + 'px';
      } else {
        panel.style.maxHeight = '0px';
      }
    }

    items.forEach((item) => {
      const head = item.querySelector('.acc-head');
      const panel = item.querySelector('.acc-panel');
      if (!head || !panel) return;

      // initialize
      if (item.classList.contains('is-open')) {
        requestAnimationFrame(() => setMaxHeight(panel, true));
      } else {
        panel.style.maxHeight = '0px';
      }

      head.addEventListener('click', () => {
        const willOpen = !item.classList.contains('is-open');

        // close all
        items.forEach((other) => {
          const otherHead = other.querySelector('.acc-head');
          const otherPanel = other.querySelector('.acc-panel');
          other.classList.remove('is-open');
          if (otherHead) otherHead.setAttribute('aria-expanded', 'false');
          if (otherPanel) setMaxHeight(otherPanel, false);
        });

        if (willOpen) {
          item.classList.add('is-open');
          head.setAttribute('aria-expanded', 'true');
          setMaxHeight(panel, true);
        }
      });
    });

    // recalc on resize for open panels
    window.addEventListener('resize', () => {
      items.forEach((item) => {
        if (!item.classList.contains('is-open')) return;
        const panel = item.querySelector('.acc-panel');
        if (panel) {
          panel.style.maxHeight = 'none';
          const h = panel.scrollHeight;
          panel.style.maxHeight = h + 'px';
        }
      });
    });
  })();
</script>
