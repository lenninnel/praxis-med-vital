---
import Layout from '../../layouts/Layout.astro';
import leistungen from '../../data/leistungen.json';
---

<Layout title="Leistungen – Praxis Med Vital" description="Unser Behandlungsspektrum: Manuelle Therapie, Lymphdrainage, Krankengymnastik und mehr.">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Leistungen</span>
      <h1>Unser Behandlungsspektrum</h1>
      <p>Evidenzbasierte Therapie — individuell auf Ihre Bedürfnisse abgestimmt.</p>
    </div>
  </section>

  <section class="sec reveal">
    <div class="container">
      <div class="leistung-grid">
        {leistungen.map((l: any) => (
          <div class="leistung-card">
            <span class="leistung-card__num">{l.num}</span>
            <h3 class="leistung-card__title">{l.name}</h3>
            <p class="leistung-card__desc">{l.desc}</p>
            <div class="tag-list" style="justify-content:flex-start">
              {l.items.map((item: string) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--g900 reveal">
    <div class="container text-center">
      <span class="eyebrow">Spezialisierungen</span>
      <hr class="rule" style="margin-inline:auto"/>
      <h2 class="section-title" style="margin-top:18px">Über den Standard hinaus</h2>
      <p class="section-sub">
        Zusätzlich zu unserem klassischen Angebot bieten wir spezialisierte Behandlungsmethoden.
      </p>
    </div>
    <div class="container" style="margin-top:48px">
      <div class="features-grid">
        <div class="feature">
          <div class="feature__icon">AK</div>
          <h3 class="feature__title">Applied Kinesiology</h3>
          <p class="feature__text">
            Funktionelle Diagnostik durch Muskeltests. Erkennung und Behandlung von
            Zusammenhängen zwischen Struktur, Biochemie und Psyche.
          </p>
        </div>
        <div class="feature">
          <div class="feature__icon">CC</div>
          <h3 class="feature__title">Cranio Concept</h3>
          <p class="feature__text">
            Sanfte craniosacrale Therapie zur Behandlung von Kopfschmerzen, Migräne,
            Kiefergelenksbeschwerden und stressbedingten Symptomen.
          </p>
        </div>
        <div class="feature">
          <div class="feature__icon">AT</div>
          <h3 class="feature__title">Atlas Therapie</h3>
          <p class="feature__text">
            Gezielte Korrektur von Fehlstellungen des ersten Halswirbels mit
            positiven Auswirkungen auf das gesamte Bewegungssystem.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--cream reveal">
    <div class="container text-center">
      <span class="eyebrow">Ohne Überweisung</span>
      <hr class="rule" style="margin-inline:auto"/>
      <h2 class="section-title" style="margin-top:18px">Sektoraler Heilpraktiker</h2>
      <p class="section-sub">
        Als sektorale Heilpraktiker für Physiotherapie dürfen wir Sie auch ohne ärztliche
        Überweisung behandeln. Das bedeutet: schnellere Termine, eigenständige Befunderhebung
        und direkter Zugang zu allen physiotherapeutischen Heilmitteln.
      </p>
      <a href="/kontakt" class="btn-primary" style="margin-top:28px">Termin anfragen</a>
    </div>
  </section>
</Layout>
