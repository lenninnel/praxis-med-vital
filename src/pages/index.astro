---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import team from '../data/team.json';
import leistungen from '../data/leistungen.json';

const kategorien = leistungen.kategorien;
---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__content">
      <span class="hero__eyebrow">Physiotherapie · Wörth am Main</span>
      <h1 class="hero__title">[Slogan]</h1>
      <p class="hero__sub">
        Ganzheitliche Physiotherapie, manuelle Therapie und innovative
        Behandlungsmethoden — individuell auf Sie abgestimmt.
      </p>
      <div class="hero__actions">
        <a href="/leistungen" class="btn-ghost">Leistungen entdecken →</a>
      </div>
    </div>
    <div class="hero__visual" aria-hidden="true">
      <div class="hero__image-placeholder">
        <div class="hero__image-inner">
          <svg viewBox="0 0 48 48" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1">
            <rect x="6" y="6" width="36" height="36" rx="2"/>
            <circle cx="18" cy="20" r="3"/>
            <path d="M6 32l10-10 16 16"/>
            <path d="M28 28l6-6 8 8"/>
          </svg>
          <p class="hero__image-label">Praxisfoto</p>
          <p class="hero__image-sub">folgt in Kürze</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <div class="trust-bar">
    <div class="trust-bar__grid">
      <div class="trust-bar__inner">
        <span class="trust-bar__number">10+</span>
        <span class="trust-bar__text">Therapeuten</span>
      </div>
      <span class="trust-bar__dot" aria-hidden="true"></span>
      <div class="trust-bar__inner">
        <span class="trust-bar__number">15+</span>
        <span class="trust-bar__text">Jahre Erfahrung</span>
      </div>
      <span class="trust-bar__dot" aria-hidden="true"></span>
      <div class="trust-bar__inner">
        <a href={`tel:${site.phonePlain}`} class="trust-bar__tel">{site.phone}</a>
      </div>
      <span class="trust-bar__dot" aria-hidden="true"></span>
      <div class="trust-bar__inner">
        <span class="trust-bar__number">2</span>
        <span class="trust-bar__text">Standorte</span>
      </div>
    </div>
  </div>

  <!-- Über uns -->
  <section class="sec sec--white reveal">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Über uns</span>
        <h2 class="section-title">Praxis Med Vital</h2>
        <p class="section-sub">
          In unserer Praxis verbinden wir klassische Physiotherapie mit innovativen, ganzheitlichen
          Behandlungsmethoden. Unser Ziel: nachhaltige Besserung — nicht nur Symptombekämpfung.
        </p>
        <p style="font-size:14px;font-weight:300;color:var(--ink-mid);margin-top:16px;line-height:1.7">
          Jeder Patient erhält bei uns einen individuellen Therapieplan, der auf seine
          Bedürfnisse und Ziele abgestimmt ist. Mit unserem besonders gelenkschonenden orthopädisch-koordinativen Trainingszirkel haben wir zusätzliche Möglichkeiten — selbst starke Einschränkungen können hier trainiert werden.
        </p>
        <a href="/ueber-uns" class="btn-ghost btn-ghost--dark" style="margin-top:32px">Mehr erfahren →</a>
      </div>
      <div class="philo-quote">
        <span class="philo-quote__mark">+</span>
        <p class="philo-quote__text">
          Ganzheitlich &amp; individuell — mehr als klassische Physiotherapie. Wir behandeln den ganzen Menschen.
        </p>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="sec sec--stone-lt reveal">
    <div class="container text-center">
      <span class="eyebrow">Unser Team</span>
      <h2 class="section-title">Kompetenz trifft Leidenschaft</h2>
      <p class="section-sub">
        Drei erfahrene Therapeuten mit unterschiedlichen Spezialisierungen — für eine umfassende Versorgung.
      </p>
    </div>
    <div class="container" style="margin-top:56px">
      <div class="team-grid">
        {team.map((member: any) => (
          <div class="team-card">
            <div class="team-card__avatar">{member.initials}</div>
            <h3 class="team-card__name">{member.name}</h3>
            <p class="team-card__role">{member.role}</p>
            <p class="team-card__bio">{member.bio}</p>
            <div class="tag-list">
              {member.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:48px">
        <a href="/team" class="btn-ghost btn-ghost--dark">Zum Team →</a>
      </div>
    </div>
  </section>

  <!-- Leistungen -->
  <section class="sec sec--cream reveal">
    <div class="container text-center">
      <span class="eyebrow">Leistungen</span>
      <h2 class="section-title">Behandlungsspektrum</h2>
      <p class="section-sub">
        Bewährte physiotherapeutische Methoden, ergänzt durch komplementäre Spezialmethoden.
      </p>
    </div>
    <div class="container" style="margin-top:56px">
      <div class="leistung-grid">
        {kategorien.map((kat: any) => (
          <a href={`/leistungen#${kat.id}`} class="leistung-card">
            <span class="leistung-card__num">{kat.num}</span>
            <h3 class="leistung-card__title">{kat.titel}</h3>
            <p class="leistung-card__desc">{kat.beschreibung}</p>
            <ul class="leistung-card__items">
              {kat.leistungen.slice(0, 3).map((l: any) => (
                <li>{l.name}</li>
              ))}
            </ul>
            <span class="back-link" style="margin-top:auto">Mehr erfahren →</span>
          </a>
        ))}
      </div>
      <div style="text-align:center;margin-top:48px">
        <a href="/leistungen" class="btn-ghost btn-ghost--dark">Alle Leistungen →</a>
      </div>
    </div>
  </section>

  <!-- Besonderheiten -->
  <section class="sec sec--sage reveal">
    <div class="container text-center">
      <span class="eyebrow">Besonderheiten</span>
      <h2 class="section-title">Was uns auszeichnet</h2>
      <p class="section-sub">
        Spezialisierte Behandlungsmethoden, die über die klassische Physiotherapie hinausgehen.
      </p>
    </div>
    <div class="container" style="margin-top:56px">
      <div class="features-grid">
        <div class="feature">
          <div class="feature__icon">AK</div>
          <h3 class="feature__title">Applied Kinesiology</h3>
          <p class="feature__text">
            Diagnostisches Verfahren, das Muskeltests nutzt, um funktionelle Zusammenhänge
            im Körper zu erkennen und gezielt zu behandeln.
          </p>
        </div>
        <div class="feature">
          <div class="feature__icon">CC</div>
          <h3 class="feature__title">Cranio Concept</h3>
          <p class="feature__text">
            Sanfte, manuelle Technik zur Behandlung des craniosacralen Systems.
            Unterstützt die Selbstheilungskräfte bei Kopfschmerzen und Migräne.
          </p>
        </div>
        <div class="feature">
          <div class="feature__icon">AT</div>
          <h3 class="feature__title">Atlas Therapie</h3>
          <p class="feature__text">
            Gezielte Behandlung des ersten Halswirbels zur Korrektur von Fehlstellungen
            mit positiven Auswirkungen auf das gesamte Bewegungssystem.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Patientenstimmen -->
  <section class="sec sec--sage-lt reveal">
    <div class="container text-center">
      <span class="eyebrow">Patientenstimmen</span>
      <h2 class="section-title">Was unsere Patienten sagen</h2>
    </div>
    <div class="container" style="margin-top:56px">
      <div class="stimmen-grid">
        <article class="stimme-card">
          <p class="stimme-card__text">
            „Einfach super! Ich kann diese Praxis wirklich sehr empfehlen. Das ganze Team ist mega nett und total engagiert. Dort ist man im wahrsten Sinne des Wortes in besten Händen."
          </p>
          <p class="stimme-card__author">Patient · Google Bewertung</p>
        </article>
        <article class="stimme-card">
          <p class="stimme-card__text">
            „Sehr gute Praxis mit erfahrenen und fachlich sehr kompetenten Therapeuten, schnelle und unkomplizierte Terminvereinbarung! Auch Geräte und Laufband stehen zur Verfügung."
          </p>
          <p class="stimme-card__author">Patient · Google Bewertung</p>
        </article>
      </div>
      <p style="text-align:center;margin-top:40px">
        <a
          href="https://maps.google.com/?q=Pfarrer-Adam-Haus-Str.+5a,+63939+W%C3%B6rth+am+Main"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost btn-ghost--dark"
        >
          Bewertungen auf Google Maps →
        </a>
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section style="background: var(--sage); padding: 80px 8%; text-align: center;">
    <p style="font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(240,235,225,0.45);margin-bottom:16px;">Kontakt</p>
    <h2 style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(36px,4vw,56px);font-weight:400;color:rgba(240,235,225,0.92);margin-bottom:32px;line-height:1.1;">
      Vereinbaren Sie<br>Ihren Termin.
    </h2>
    <div style="display:flex;align-items:center;justify-content:center;gap:32px;flex-wrap:wrap;">
      <a href="tel:093721394440" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:28px;color:rgba(240,235,225,0.85);text-decoration:none;">09372 – 139 444</a>
      <span style="color:rgba(240,235,225,0.2);font-size:20px;">·</span>
      <a href="/kontakt" style="font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:var(--gold-lt);text-decoration:none;border-bottom:0.5px solid var(--gold);padding-bottom:2px;">
        Zum Kontaktformular
      </a>
    </div>
  </section>
</Layout>

<style>
  .philo-quote {
    background: var(--cream);
    border: 0.5px solid var(--border);
    padding: 56px 44px;
    text-align: center;
    position: relative;
  }
  .philo-quote__mark {
    display: inline-block;
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: 64px;
    font-weight: 300;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 24px;
  }
  .philo-quote__text {
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: 22px;
    font-weight: 400;
    color: var(--ink);
    line-height: 1.5;
    max-width: 380px;
    margin: 0 auto;
  }

  .stimmen-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    max-width: 960px;
    margin: 0 auto;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .stimme-card {
    background: var(--white);
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .stimme-card__text {
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: 19px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--ink);
  }

  .stimme-card__author {
    margin-top: auto;
    font-family: var(--ff-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--ink-lt);
  }

  @media (max-width: 860px) {
    .stimmen-grid { grid-template-columns: 1fr; }
  }
</style>
