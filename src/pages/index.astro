---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import team from '../data/team.json';
import leistungen from '../data/leistungen.json';
import standorte from '../data/standorte.json';

const kategorien = leistungen.kategorien;
const woerth = standorte.find((s: any) => s.id === 'woerth')!;
---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__content">
      <span class="hero__eyebrow">Physiotherapie in Wörth am Main</span>
      <h1 class="hero__title">Ihre Gesundheit.<br/><em>Unser Antrieb.</em></h1>
      <p class="hero__claim">
        Wir untersuchen Sie, wir behandeln Sie und trainieren Sie. Ihre Alltagsmobilität steht bei uns an erster Stelle.
      </p>
      <p class="hero__sub">
        Ganzheitliche Physiotherapie, manuelle Therapie und innovative
        Behandlungsmethoden — individuell auf Sie abgestimmt.
      </p>
      <div class="hero__actions">
        <a href="/kontakt" class="btn-primary">Termin anfragen</a>
        <a href="/leistungen" class="btn-ghost">Unsere Leistungen →</a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <div class="trust-bar">
    <div class="trust-bar__grid">
      <div class="trust-bar__item">
        <span class="trust-bar__number">3</span>
        <span class="trust-bar__text">Therapeuten</span>
      </div>
      <div class="trust-bar__item">
        <span class="trust-bar__number">15+</span>
        <span class="trust-bar__text">Jahre Erfahrung</span>
      </div>
      <div class="trust-bar__item">
        <span class="trust-bar__number">2</span>
        <span class="trust-bar__text">Standorte</span>
      </div>
      <div class="trust-bar__item">
        <span class="trust-bar__number">100%</span>
        <span class="trust-bar__text">Kassenzulassung</span>
      </div>
    </div>
  </div>

  <!-- Über uns -->
  <section class="sec reveal">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Über uns</span>
        <hr class="rule"/>
        <h2 class="section-title" style="margin-top:18px">Praxis Med Vital</h2>
        <p class="section-sub" style="margin-top:14px">
          In unserer Praxis verbinden wir klassische Physiotherapie mit innovativen, ganzheitlichen
          Behandlungsmethoden. Unser Ziel: nachhaltige Besserung — nicht nur Symptombekämpfung.
        </p>
        <p style="font-size:15px;font-weight:300;color:var(--ink-mid);margin-top:14px">
          Jeder Patient erhält bei uns einen individuellen Therapieplan, der auf seine
          Bedürfnisse und Ziele abgestimmt ist.
        </p>
        <p style="font-size:15px;font-weight:300;color:var(--ink-mid);margin-top:14px">
          Mit unserem besonders gelenkschonenden orthopädisch-koordinativen Trainingszirkel haben wir zusätzliche Möglichkeiten, Patienten intensiver zu behandeln — selbst starke Einschränkungen können hier trainiert werden.
        </p>
        <a href="/ueber-uns" class="btn-ghost btn-ghost--dark" style="margin-top:28px">Mehr erfahren →</a>
      </div>
      <div style="background:var(--g50);border-radius:6px;padding:48px 36px;text-align:center">
        <span style="font-size:48px;display:block;margin-bottom:16px;opacity:.7">✦</span>
        <h3 style="font-size:24px;margin-bottom:8px">Ganzheitlich &amp; individuell</h3>
        <p style="font-size:14px;font-weight:300;color:var(--ink-mid)">
          Mehr als klassische Physiotherapie — wir behandeln den ganzen Menschen.
        </p>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="sec sec--cream reveal">
    <div class="container text-center">
      <span class="eyebrow">Unser Team</span>
      <hr class="rule"/>
      <h2 class="section-title" style="margin-top:18px">Kompetenz trifft Leidenschaft</h2>
      <p class="section-sub">
        Drei erfahrene Therapeuten mit unterschiedlichen Spezialisierungen — für eine umfassende Versorgung.
      </p>
    </div>
    <div class="container" style="margin-top:48px">
      <div class="team-grid">
        {team.map((member: any) => (
          <div class="team-card">
            <div class="team-card__avatar">{member.initials}</div>
            <h3 class="team-card__name">{member.name}</h3>
            <p class="team-card__role">{member.role}</p>
            <p class="team-card__bio">{member.bio}</p>
            <div class="tag-list">
              {member.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:40px">
        <a href="/team" class="btn-ghost btn-ghost--dark">Zum Team →</a>
      </div>
    </div>
  </section>

  <!-- Leistungen -->
  <section class="sec reveal">
    <div class="container text-center">
      <span class="eyebrow">Leistungen</span>
      <hr class="rule"/>
      <h2 class="section-title" style="margin-top:18px">Unser Behandlungsspektrum</h2>
      <p class="section-sub">
        Von Krankengymnastik bis Manuelle Therapie — ein breites Spektrum an evidenzbasierten Behandlungen.
      </p>
    </div>
    <div class="container" style="margin-top:48px">
      <div class="kategorien-grid">
        {kategorien.map((kat: any) => (
          <a href={`/leistungen#${kat.id}`} class="kategorie-card">
            <span class="kategorie-card__num">{kat.num}</span>
            <h3 class="kategorie-card__title">{kat.titel}</h3>
            <p class="kategorie-card__desc">{kat.beschreibung}</p>
            <ul class="kategorie-card__list">
              {kat.leistungen.slice(0, 3).map((l: any) => (
                <li>{l.name}</li>
              ))}
            </ul>
            <span class="kategorie-card__link">Mehr erfahren →</span>
          </a>
        ))}
      </div>
      <div style="text-align:center;margin-top:40px">
        <a href="/leistungen" class="btn-ghost btn-ghost--dark">Alle Leistungen →</a>
      </div>
    </div>
  </section>

  <!-- Besonderheiten -->
  <section class="sec sec--g900 reveal">
    <div class="container text-center">
      <span class="eyebrow">Besonderheiten</span>
      <hr class="rule" style="margin-inline:auto"/>
      <h2 class="section-title" style="margin-top:18px">Was uns auszeichnet</h2>
      <p class="section-sub">
        Spezialisierte Behandlungsmethoden, die über die klassische Physiotherapie hinausgehen.
      </p>
    </div>
    <div class="container" style="margin-top:48px">
      <div class="features-grid">
        <div class="feature">
          <div class="feature__icon">AK</div>
          <h3 class="feature__title">Applied Kinesiology</h3>
          <p class="feature__text">
            Diagnostisches Verfahren, das Muskeltests nutzt, um funktionelle Zusammenhänge
            im Körper zu erkennen und gezielt zu behandeln.
          </p>
        </div>
        <div class="feature">
          <div class="feature__icon">CC</div>
          <h3 class="feature__title">Cranio Concept</h3>
          <p class="feature__text">
            Sanfte, manuelle Technik zur Behandlung des craniosacralen Systems.
            Unterstützt die Selbstheilungskräfte bei Kopfschmerzen und Migräne.
          </p>
        </div>
        <div class="feature">
          <div class="feature__icon">AT</div>
          <h3 class="feature__title">Atlas Therapie</h3>
          <p class="feature__text">
            Gezielte Behandlung des ersten Halswirbels zur Korrektur von Fehlstellungen
            mit positiven Auswirkungen auf das gesamte Bewegungssystem.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Patientenstimmen -->
  <section class="sec sec--cream reveal">
    <div class="container text-center">
      <span class="eyebrow">Patientenstimmen</span>
      <hr class="rule" style="margin-inline:auto"/>
      <h2 class="section-title" style="margin-top:18px">Was unsere Patienten sagen.</h2>
    </div>
    <div class="container" style="margin-top:48px">
      <div class="stimmen-grid">
        <article class="stimme-card">
          <div class="stimme-card__stars" aria-label="5 von 5 Sternen">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <p class="stimme-card__text">
            „Einfach super! Ich kann diese Praxis wirklich sehr empfehlen. Das ganze Team ist mega nett und total engagiert. Dort ist man im wahrsten Sinne des Wortes in besten Händen."
          </p>
          <p class="stimme-card__author">Patient · Google Bewertung</p>
        </article>
        <article class="stimme-card">
          <div class="stimme-card__stars" aria-label="5 von 5 Sternen">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <p class="stimme-card__text">
            „Sehr gute Praxis mit erfahrenen und fachlich sehr kompetenten Therapeuten, schnelle und unkomplizierte Terminvereinbarung! Auch Geräte und Laufband stehen zur Verfügung."
          </p>
          <p class="stimme-card__author">Patient · Google Bewertung</p>
        </article>
      </div>
      <p class="stimmen-link-wrap">
        <a
          href="https://maps.google.com/?q=Pfarrer-Adam-Haus-Str.+5a,+63939+W%C3%B6rth+am+Main"
          target="_blank"
          rel="noopener noreferrer"
          class="stimmen-link"
        >
          Weitere Bewertungen auf Google Maps →
        </a>
      </p>
    </div>
  </section>

  <!-- Kontakt -->
  <section class="sec sec--cream reveal" id="kontakt">
    <div class="container">
      <div class="contact-grid">
        <div>
          <span class="eyebrow">Kontakt</span>
          <hr class="rule"/>
          <h2 class="section-title" style="margin-top:18px">Termin anfragen</h2>
          <p class="section-sub" style="margin-top:14px">
            Nutzen Sie unser Kontaktformular oder rufen Sie uns direkt an.
          </p>
          <div style="margin-top:32px">
            <div class="contact-detail">
              <div class="contact-detail__icon">A</div>
              <div class="contact-detail__text">
                <h4>Adresse</h4>
                <p>{woerth.address}<br/>{woerth.zip} {woerth.city}</p>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail__icon">T</div>
              <div class="contact-detail__text">
                <h4>Telefon</h4>
                <p><a href={`tel:${site.phonePlain}`}>{site.phone}</a></p>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail__icon">@</div>
              <div class="contact-detail__text">
                <h4>E-Mail</h4>
                <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail__icon">F</div>
              <div class="contact-detail__text">
                <h4>Fax</h4>
                <p>{site.fax}</p>
              </div>
            </div>
          </div>

          <h3 style="font-family:var(--ff-serif);font-size:18px;font-weight:600;margin-top:32px;margin-bottom:10px;color:var(--g900)">Öffnungszeiten</h3>
          <table class="hours-table">
            {site.hours.map((h: any) => (
              <tr>
                <td>{h.days}</td>
                <td>{h.time}</td>
              </tr>
            ))}
          </table>
        </div>
        <form class="contact-form" name="kontakt" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="kontakt" />
          <p class="full" style="display:none">
            <label>Nicht ausfüllen: <input name="bot-field" /></label>
          </p>
          <div class="form-group">
            <label for="vorname">Vorname *</label>
            <input type="text" id="vorname" name="vorname" required />
          </div>
          <div class="form-group">
            <label for="nachname">Nachname *</label>
            <input type="text" id="nachname" name="nachname" required />
          </div>
          <div class="form-group full">
            <label for="email">E-Mail *</label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="form-group full">
            <label for="telefon">Telefon</label>
            <input type="tel" id="telefon" name="telefon" />
          </div>
          <div class="form-group full">
            <label for="nachricht">Ihre Nachricht *</label>
            <textarea id="nachricht" name="nachricht" rows="5" required></textarea>
          </div>
          <div class="full">
            <button type="submit" class="btn-primary">Nachricht senden</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero__claim {
    font-family: var(--ff-serif);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 400;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.88);
    max-width: 640px;
    margin-bottom: 22px;
    border-left: 2px solid var(--amber);
    padding-left: 20px;
  }

  .kategorien-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .kategorie-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 40px 36px 36px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--white);
    overflow: hidden;
    transition: transform .3s, box-shadow .3s, border-color .3s;
  }

  .kategorie-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 0; height: 2.5px;
    background: var(--g700);
    transition: width .4s;
  }

  .kategorie-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(11,61,46,.07);
    border-color: var(--g100);
  }
  .kategorie-card:hover::before { width: 100%; }

  .kategorie-card__num {
    font-family: var(--ff-serif);
    font-size: 88px;
    font-weight: 700;
    color: var(--g50);
    line-height: 1;
    margin-bottom: 8px;
    pointer-events: none;
  }

  .kategorie-card__title {
    font-family: var(--ff-serif);
    font-size: 28px;
    font-weight: 600;
    color: var(--g900);
    margin-bottom: 12px;
    line-height: 1.15;
  }

  .kategorie-card__desc {
    font-size: 14px;
    font-weight: 300;
    color: var(--ink-mid);
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .kategorie-card__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
  }

  .kategorie-card__list li {
    position: relative;
    padding-left: 20px;
    font-size: 14px;
    font-weight: 400;
    color: var(--g900);
    line-height: 1.5;
  }

  .kategorie-card__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 10px;
    height: 2px;
    background: var(--amber);
  }

  .kategorie-card__link {
    margin-top: auto;
    font-size: 13px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: .04em;
  }

  @media (max-width: 960px) {
    .kategorien-grid { grid-template-columns: 1fr; }
  }

  .stimmen-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    max-width: 960px;
    margin: 0 auto;
  }

  .stimme-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 36px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .stimme-card__stars {
    display: flex;
    gap: 2px;
    color: var(--amber);
    font-size: 18px;
    line-height: 1;
    letter-spacing: 1px;
  }

  .stimme-card__text {
    font-family: var(--ff-serif);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--g900);
    font-style: italic;
  }

  .stimme-card__author {
    margin-top: auto;
    font-family: var(--ff-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--ink-lt);
  }

  .stimmen-link-wrap {
    text-align: center;
    margin-top: 36px;
  }

  .stimmen-link {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .04em;
    color: var(--amber);
    transition: color .2s;
  }

  .stimmen-link:hover { color: var(--amber-dk); }

  @media (max-width: 860px) {
    .stimmen-grid { grid-template-columns: 1fr; }
  }
</style>
