---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import team from '../data/team.json';
import leistungen from '../data/leistungen.json';
---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__content">
      <span class="hero__eyebrow">Physiotherapie in Wörth am Main</span>
      <h1 class="hero__title">Ihre Gesundheit.<br/><em>Unser Antrieb.</em></h1>
      <p class="hero__sub">
        Ganzheitliche Physiotherapie, manuelle Therapie und innovative
        Behandlungsmethoden — individuell auf Sie abgestimmt.
      </p>
      <div class="hero__actions">
        <a href="/kontakt" class="btn-primary">Termin anfragen</a>
        <a href="/leistungen" class="btn-ghost">Unsere Leistungen →</a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <div class="trust-bar">
    <div class="trust-bar__grid">
      <div class="trust-bar__item">
        <span class="trust-bar__number">3</span>
        <span class="trust-bar__text">Therapeuten</span>
      </div>
      <div class="trust-bar__item">
        <span class="trust-bar__number">15+</span>
        <span class="trust-bar__text">Jahre Erfahrung</span>
      </div>
      <div class="trust-bar__item">
        <span class="trust-bar__number">2</span>
        <span class="trust-bar__text">Standorte</span>
      </div>
      <div class="trust-bar__item">
        <span class="trust-bar__number">100%</span>
        <span class="trust-bar__text">Kassenzulassung</span>
      </div>
    </div>
  </div>

  <!-- Über uns -->
  <section class="sec reveal">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Über uns</span>
        <hr class="rule"/>
        <h2 class="section-title" style="margin-top:18px">Praxis Med Vital</h2>
        <p class="section-sub" style="margin-top:14px">
          In unserer Praxis verbinden wir klassische Physiotherapie mit innovativen, ganzheitlichen
          Behandlungsmethoden. Unser Ziel: nachhaltige Besserung — nicht nur Symptombekämpfung.
        </p>
        <p style="font-size:15px;font-weight:300;color:var(--ink-mid);margin-top:14px">
          Jeder Patient erhält bei uns einen individuellen Therapieplan, der auf seine
          Bedürfnisse und Ziele abgestimmt ist.
        </p>
        <a href="/ueber-uns" class="btn-ghost btn-ghost--dark" style="margin-top:28px">Mehr erfahren →</a>
      </div>
      <div style="background:var(--g50);border-radius:6px;padding:48px 36px;text-align:center">
        <span style="font-size:48px;display:block;margin-bottom:16px;opacity:.7">✦</span>
        <h3 style="font-size:24px;margin-bottom:8px">Ganzheitlich &amp; individuell</h3>
        <p style="font-size:14px;font-weight:300;color:var(--ink-mid)">
          Mehr als klassische Physiotherapie — wir behandeln den ganzen Menschen.
        </p>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="sec sec--cream reveal">
    <div class="container text-center">
      <span class="eyebrow">Unser Team</span>
      <hr class="rule"/>
      <h2 class="section-title" style="margin-top:18px">Kompetenz trifft Leidenschaft</h2>
      <p class="section-sub">
        Drei erfahrene Therapeuten mit unterschiedlichen Spezialisierungen — für eine umfassende Versorgung.
      </p>
    </div>
    <div class="container" style="margin-top:48px">
      <div class="team-grid">
        {team.map((member: any) => (
          <div class="team-card">
            <div class="team-card__avatar">{member.initials}</div>
            <h3 class="team-card__name">{member.name}</h3>
            <p class="team-card__role">{member.role}</p>
            <p class="team-card__bio">{member.bio}</p>
            <div class="tag-list">
              {member.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:40px">
        <a href="/team" class="btn-ghost btn-ghost--dark">Zum Team →</a>
      </div>
    </div>
  </section>

  <!-- Leistungen -->
  <section class="sec reveal">
    <div class="container text-center">
      <span class="eyebrow">Leistungen</span>
      <hr class="rule"/>
      <h2 class="section-title" style="margin-top:18px">Unser Behandlungsspektrum</h2>
      <p class="section-sub">
        Von Krankengymnastik bis Manuelle Therapie — ein breites Spektrum an evidenzbasierten Behandlungen.
      </p>
    </div>
    <div class="container" style="margin-top:48px">
      <div class="leistung-grid">
        {leistungen.map((l: any) => (
          <div class="leistung-card">
            <span class="leistung-card__num">{l.num}</span>
            <h3 class="leistung-card__title">{l.name}</h3>
            <p class="leistung-card__desc">{l.desc}</p>
            <div class="tag-list" style="justify-content:flex-start">
              {l.items.map((item: string) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:40px">
        <a href="/leistungen" class="btn-ghost btn-ghost--dark">Alle Leistungen →</a>
      </div>
    </div>
  </section>

  <!-- Besonderheiten -->
  <section class="sec sec--g900 reveal">
    <div class="container text-center">
      <span class="eyebrow">Besonderheiten</span>
      <hr class="rule" style="margin-inline:auto"/>
      <h2 class="section-title" style="margin-top:18px">Was uns auszeichnet</h2>
      <p class="section-sub">
        Spezialisierte Behandlungsmethoden, die über die klassische Physiotherapie hinausgehen.
      </p>
    </div>
    <div class="container" style="margin-top:48px">
      <div class="features-grid">
        <div class="feature">
          <div class="feature__icon">AK</div>
          <h3 class="feature__title">Applied Kinesiology</h3>
          <p class="feature__text">
            Diagnostisches Verfahren, das Muskeltests nutzt, um funktionelle Zusammenhänge
            im Körper zu erkennen und gezielt zu behandeln.
          </p>
        </div>
        <div class="feature">
          <div class="feature__icon">CC</div>
          <h3 class="feature__title">Cranio Concept</h3>
          <p class="feature__text">
            Sanfte, manuelle Technik zur Behandlung des craniosacralen Systems.
            Unterstützt die Selbstheilungskräfte bei Kopfschmerzen und Migräne.
          </p>
        </div>
        <div class="feature">
          <div class="feature__icon">AT</div>
          <h3 class="feature__title">Atlas Therapie</h3>
          <p class="feature__text">
            Gezielte Behandlung des ersten Halswirbels zur Korrektur von Fehlstellungen
            mit positiven Auswirkungen auf das gesamte Bewegungssystem.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Kontakt -->
  <section class="sec sec--cream reveal" id="kontakt">
    <div class="container">
      <div class="contact-grid">
        <div>
          <span class="eyebrow">Kontakt</span>
          <hr class="rule"/>
          <h2 class="section-title" style="margin-top:18px">Termin anfragen</h2>
          <p class="section-sub" style="margin-top:14px">
            Nutzen Sie unser Kontaktformular oder rufen Sie uns direkt an.
          </p>
          <div style="margin-top:32px">
            <div class="contact-detail">
              <div class="contact-detail__icon">T</div>
              <div class="contact-detail__text">
                <h4>Telefon</h4>
                <p><a href={`tel:${site.phonePlain}`}>{site.phone}</a></p>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail__icon">@</div>
              <div class="contact-detail__text">
                <h4>E-Mail</h4>
                <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail__icon">F</div>
              <div class="contact-detail__text">
                <h4>Fax</h4>
                <p>{site.fax}</p>
              </div>
            </div>
          </div>
        </div>
        <form class="contact-form" name="kontakt" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="kontakt" />
          <p class="full" style="display:none">
            <label>Nicht ausfüllen: <input name="bot-field" /></label>
          </p>
          <div class="form-group">
            <label for="vorname">Vorname *</label>
            <input type="text" id="vorname" name="vorname" required />
          </div>
          <div class="form-group">
            <label for="nachname">Nachname *</label>
            <input type="text" id="nachname" name="nachname" required />
          </div>
          <div class="form-group full">
            <label for="email">E-Mail *</label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="form-group full">
            <label for="telefon">Telefon</label>
            <input type="tel" id="telefon" name="telefon" />
          </div>
          <div class="form-group full">
            <label for="nachricht">Ihre Nachricht *</label>
            <textarea id="nachricht" name="nachricht" rows="5" required></textarea>
          </div>
          <div class="full">
            <button type="submit" class="btn-primary">Nachricht senden</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>
