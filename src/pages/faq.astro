---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';

type FaqItem = {
  frage: string;
  intro?: string;
  bullets?: { label: string; text: string }[];
  outro?: string;
};

const faqs: FaqItem[] = [
  {
    frage: 'Ich habe ein Rezept von meinem Arzt erhalten — wie geht es nun weiter?',
    intro: 'Super, dann haben Sie schon das Wichtigste vorliegen! Kontaktieren Sie uns für eine Terminvereinbarung. Bitte halten Sie folgende Informationen bereit:',
    bullets: [
      {
        label: 'Rezeptdatum',
        text: "Ein Rezept ist nur 28 Tage nach Ausstellungsdatum gültig (14 Tage bei „dringender Behandlungsbedarf\"). Wir bemühen uns um schnellstmögliche Terminvergabe, können aber manchmal keinen Beginn innerhalb der 28 Tage garantieren. Vereinbaren Sie zunächst Ihre Termine und lassen Sie das Rezeptdatum gegebenenfalls von Ihrer Arztpraxis umdatieren.",
      },
      {
        label: 'Verordnetes Heilmittel',
        text: 'z. B. KG (Krankengymnastik), MT (Manuelle Therapie), MLD (Manuelle Lymphdrainage).',
      },
      {
        label: 'Anzahl der Behandlungseinheiten',
        text: 'Damit wir die passende Terminkette für Sie planen können.',
      },
    ],
  },
  {
    frage: 'Ich bin privatversichert — wie läuft das ab?',
    intro: 'Bitte teilen Sie uns bei der Terminvereinbarung mit, ob Sie privat- oder beihilfeversichert sind. Beim ersten Termin erhalten Sie eine Honorarvereinbarung, die Sie einmalig unterschrieben bei uns abgeben. Die Höhe der Erstattung durch Ihre Krankenkasse hängt von Ihrem gewählten Tarif ab.',
  },
  {
    frage: 'Wie lange dauert eine Behandlung?',
    intro: 'Die Behandlungsdauer hängt von Ihrer Verordnung ab:',
    bullets: [
      { label: 'Krankengymnastik, Manuelle Therapie', text: 'ca. 20 Minuten inkl. Vor- und Nachbereitung.' },
      { label: 'Manuelle Lymphdrainage', text: '30–60 Minuten je nach Verordnung.' },
      { label: 'Krankengymnastik am Gerät (KGG)', text: 'ca. 60 Minuten.' },
      { label: 'Privatbehandlungen', text: '40 oder 60 Minuten.' },
    ],
    outro: 'Bitte erscheinen Sie immer 5 Minuten vor Behandlungsbeginn, da ein verspäteter Start nicht nachgeholt werden kann.',
  },
  {
    frage: 'Wie läuft mein erster Termin ab?',
    intro: 'Kommen Sie bitte 10–15 Minuten früher und melden sich an der Rezeption an. Bringen Sie mit:',
    bullets: [
      { label: 'Ihr gültiges Rezept', text: '' },
      { label: 'Relevante Arztbriefe und Befunde', text: '' },
      { label: 'Ihre Krankenversichertenkarte', text: '' },
      { label: 'Ein großes Handtuch', text: '' },
    ],
    outro: 'Nach dem Ausfüllen eines kurzen Fragebogens holt Sie Ihr Therapeut im Wartebereich ab. Es folgt der Erstbefund: Ihr Therapeut bespricht Ihre Einschränkungen und Ziele und führt spezifische Tests durch — die Grundlage für eine individuell abgestimmte Therapie.',
  },
  {
    frage: 'Ich kann einen Termin nicht wahrnehmen — was nun?',
    intro: 'Bitte informieren Sie uns spätestens 24 Stunden vor Behandlungsbeginn per Telefon, E-Mail oder Anrufbeantworter. Bei kurzfristigen Absagen unter 24 Stunden, die keine anderweitige Besetzung ermöglichen, behalten wir uns vor, die Behandlung nach § 615 BGB privat in Rechnung zu stellen.',
  },
  {
    frage: 'Muss ich etwas zu meiner Behandlung zuzahlen?',
    intro: 'Als gesetzlich Versicherter leisten Sie in der Regel eine gesetzliche Zuzahlung von 10 % des Rezeptwertes plus 10 € Rezeptgebühr — sofern Sie nicht von der Zuzahlung befreit sind. Privatpatienten und Selbstzahler erhalten eine individuelle Honorarvereinbarung. Bei Fragen zur Zuzahlung sprechen Sie uns gerne direkt an.',
  },
  {
    frage: 'Kann ich nach Beendigung meines Rezepts weiterbehandelt werden?',
    intro: 'Ja — als Selbstzahler können Sie jederzeit weitere Behandlungen in Anspruch nehmen, auch ohne neues Rezept. Alternativ können Sie Ihren Arzt um eine neue Verordnung bitten. Als sektorale Heilpraktiker können wir Sie zudem ohne ärztliche Überweisung direkt und individuell behandeln.',
  },
  {
    frage: 'Kann ich auch ohne Rezept behandelt werden?',
    intro: 'Ja. Als sektorale Heilpraktiker für Physiotherapie können wir Sie ohne ärztliche Verordnung behandeln — direkt, unkompliziert und vollständig auf Ihre Bedürfnisse zugeschnitten. Die Behandlung wird als Privatleistung abgerechnet. Sprechen Sie uns einfach an.',
  },
];
---

<Layout title="FAQ – Praxis Med Vital" description="Antworten auf häufige Fragen rund um Rezept, Termin, Zuzahlung und Erstbehandlung in der Praxis Med Vital.">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Häufige Fragen</span>
      <h1>Rund um Ihren Termin</h1>
      <p>Antworten auf die häufigsten Fragen unserer Patienten — von der Rezeptannahme bis zum ersten Termin.</p>
    </div>
  </section>

  <section class="sec sec--cream reveal">
    <div class="container">
      <div class="accordion">
        {faqs.map((faq, idx) => (
          <article class:list={["acc-item", { "is-open": idx === 0 }]}>
            <button
              class="acc-head"
              type="button"
              aria-expanded={idx === 0 ? "true" : "false"}
              aria-controls={`faq-panel-${idx}`}
            >
              <span class="acc-head__num" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</span>
              <span class="acc-head__titel">{faq.frage}</span>
              <span class="acc-head__icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="4 7 9 12 14 7"/>
                </svg>
              </span>
            </button>

            <div class="acc-panel" id={`faq-panel-${idx}`} role="region">
              <div class="acc-panel__inner">
                {faq.intro && <p class="faq-text">{faq.intro}</p>}
                {faq.bullets && faq.bullets.length > 0 && (
                  <ul class="faq-list">
                    {faq.bullets.map((b) => (
                      <li class="faq-list__item">
                        {b.label && <strong class="faq-list__label">{b.label}</strong>}
                        {b.text && <span class="faq-list__text">{b.label ? ' — ' : ''}{b.text}</span>}
                      </li>
                    ))}
                  </ul>
                )}
                {faq.outro && <p class="faq-text faq-text--outro">{faq.outro}</p>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--ink reveal">
    <div class="container text-center">
      <span class="eyebrow">Noch Fragen?</span>
      <h2 class="section-title">Persönlich für Sie da</h2>
      <p class="section-sub">
        Rufen Sie uns an oder schreiben Sie uns — wir helfen gerne weiter.
      </p>
      <div class="faq-cta-row">
        <a href={`tel:${site.phonePlain}`} class="btn-primary">{site.phone}</a>
        <a href="/kontakt" class="btn-ghost">Nachricht schreiben →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .accordion {
    max-width: 880px;
    margin: 0 auto;
    border-top: 0.5px solid var(--border);
  }

  .acc-item {
    border-bottom: 0.5px solid var(--border);
    background: transparent;
  }

  .acc-head {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
    padding: 32px 4px;
    border: none;
    background: transparent;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
    transition: color .2s;
  }
  .acc-head:hover .acc-head__titel { color: var(--gold); }

  .acc-head__num {
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: 28px;
    font-weight: 400;
    color: var(--gold);
    line-height: 1;
  }

  .acc-head__titel {
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 400;
    color: var(--ink);
    line-height: 1.3;
    transition: color .2s;
  }

  .acc-head__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--ink-mid);
    transition: transform .35s ease, color .25s;
    flex-shrink: 0;
  }

  .acc-item.is-open .acc-head__icon {
    transform: rotate(180deg);
    color: var(--gold);
  }
  .acc-item.is-open .acc-head__titel { color: var(--ink); }

  .acc-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height .45s ease;
  }

  .acc-panel__inner {
    padding: 4px 4px 36px 64px;
    max-width: 760px;
  }

  .faq-text {
    font-family: var(--ff-sans);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.8;
    color: var(--ink-mid);
  }

  .faq-text--outro { margin-top: 20px; }

  .faq-list {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
  }

  .faq-list__item {
    position: relative;
    padding: 14px 0 14px 28px;
    font-family: var(--ff-sans);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--ink-mid);
    border-bottom: 0.5px solid var(--border);
  }

  .faq-list__item:last-child { border-bottom: 0; }

  .faq-list__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 24px;
    width: 14px;
    height: 0.5px;
    background: var(--gold);
  }

  .faq-list__label {
    font-family: var(--ff-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--ink);
  }

  .faq-list__text { color: var(--ink-mid); }

  .faq-cta-row {
    margin-top: 36px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  @media (max-width: 700px) {
    .acc-head { padding: 24px 4px; gap: 16px; }
    .acc-head__num { font-size: 22px; }
    .acc-panel__inner { padding: 4px 4px 28px 38px; }
  }
</style>

<script is:inline>
  (function () {
    const items = document.querySelectorAll('.acc-item');

    function setMaxHeight(panel, open) {
      if (open) {
        panel.style.maxHeight = panel.scrollHeight + 'px';
      } else {
        panel.style.maxHeight = '0px';
      }
    }

    items.forEach((item) => {
      const head = item.querySelector('.acc-head');
      const panel = item.querySelector('.acc-panel');
      if (!head || !panel) return;

      if (item.classList.contains('is-open')) {
        requestAnimationFrame(() => setMaxHeight(panel, true));
      } else {
        panel.style.maxHeight = '0px';
      }

      head.addEventListener('click', () => {
        const willOpen = !item.classList.contains('is-open');

        items.forEach((other) => {
          const otherHead = other.querySelector('.acc-head');
          const otherPanel = other.querySelector('.acc-panel');
          other.classList.remove('is-open');
          if (otherHead) otherHead.setAttribute('aria-expanded', 'false');
          if (otherPanel) setMaxHeight(otherPanel, false);
        });

        if (willOpen) {
          item.classList.add('is-open');
          head.setAttribute('aria-expanded', 'true');
          setMaxHeight(panel, true);
        }
      });
    });

    window.addEventListener('resize', () => {
      items.forEach((item) => {
        if (!item.classList.contains('is-open')) return;
        const panel = item.querySelector('.acc-panel');
        if (panel) {
          panel.style.maxHeight = 'none';
          const h = panel.scrollHeight;
          panel.style.maxHeight = h + 'px';
        }
      });
    });
  })();
</script>
