---
import Layout from '../layouts/Layout.astro';
import faqs from '../data/faq.json';
import PageHeader from '../components/PageHeader.astro';
import FaqAccordion from '../components/FaqAccordion.tsx';
import CtaBand from '../components/CtaBand.astro';
---
<Layout
  title="FAQ – med.vital"
  description="Antworten auf häufige Fragen rund um Rezept, Termin, Zuzahlung und Erstbehandlung bei med.vital."
>
  <PageHeader
    eyebrow="Häufige Fragen"
    title="Rund um Ihren Termin"
    sub="Antworten auf die häufigsten Fragen — von der Rezeptannahme bis zur ersten Behandlung."
  />
  <section class="section">
    <div class="container">
      <FaqAccordion client:visible items={faqs} />
    </div>
  </section>
  <CtaBand title="Noch Fragen? Wir helfen gern." />
</Layout>
