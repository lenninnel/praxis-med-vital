---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import standorte from '../data/standorte.json';

const woerth = standorte.find((s: any) => s.id === 'woerth');
---

<Layout title="Kontakt – Praxis Med Vital" description="Nehmen Sie Kontakt auf und vereinbaren Sie Ihren Termin bei Praxis Med Vital.">
  <section class="page-header">
    <div class="container">
      <span class="section-label">Kontakt</span>
      <h1>Wir sind für Sie da</h1>
      <p>Rufen Sie an, schreiben Sie uns oder nutzen Sie das Kontaktformular.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:start">
        <!-- Kontaktdaten -->
        <div>
          <h2>Kontaktdaten</h2>
          <div class="divider"></div>

          <div class="standort-info__detail">
            <div class="standort-info__icon">A</div>
            <div class="standort-info__text">
              <h4>Adresse</h4>
              <p>{woerth?.address}<br/>{woerth?.zip} {woerth?.city}</p>
            </div>
          </div>

          <div class="standort-info__detail">
            <div class="standort-info__icon">T</div>
            <div class="standort-info__text">
              <h4>Telefon</h4>
              <p><a href={`tel:${site.phonePlain}`}>{site.phone}</a></p>
            </div>
          </div>

          <div class="standort-info__detail">
            <div class="standort-info__icon">@</div>
            <div class="standort-info__text">
              <h4>E-Mail</h4>
              <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
            </div>
          </div>

          <div class="standort-info__detail">
            <div class="standort-info__icon">F</div>
            <div class="standort-info__text">
              <h4>Fax</h4>
              <p>{site.fax}</p>
            </div>
          </div>

          <h3 style="margin-top:2rem;font-size:var(--fs-lg)">Öffnungszeiten</h3>
          <table class="hours-table">
            {site.hours.map((h: any) => (
              <tr>
                <td><strong>{h.days}</strong></td>
                <td>{h.time}</td>
              </tr>
            ))}
          </table>
        </div>

        <!-- Formular -->
        <div>
          <h2>Termin anfragen</h2>
          <div class="divider"></div>
          <p style="margin-bottom:1.5rem;color:var(--c-gray-600);font-size:var(--fs-sm)">
            Füllen Sie das Formular aus und wir melden uns schnellstmöglich bei Ihnen.
          </p>
          <form class="contact-form" name="kontakt" method="POST" data-netlify="true" netlify-honeypot="bot-field" style="max-width:100%">
            <input type="hidden" name="form-name" value="kontakt" />
            <p class="full" style="display:none">
              <label>Nicht ausfüllen: <input name="bot-field" /></label>
            </p>
            <div class="form-group">
              <label for="vorname">Vorname *</label>
              <input type="text" id="vorname" name="vorname" required />
            </div>
            <div class="form-group">
              <label for="nachname">Nachname *</label>
              <input type="text" id="nachname" name="nachname" required />
            </div>
            <div class="form-group full">
              <label for="email">E-Mail *</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group full">
              <label for="telefon">Telefon</label>
              <input type="tel" id="telefon" name="telefon" />
            </div>
            <div class="form-group full">
              <label for="betreff">Betreff</label>
              <select id="betreff" name="betreff">
                <option value="">Bitte wählen</option>
                <option value="termin">Terminanfrage</option>
                <option value="rezept">Rezeptfrage</option>
                <option value="sonstiges">Sonstiges</option>
              </select>
            </div>
            <div class="form-group full">
              <label for="nachricht">Ihre Nachricht *</label>
              <textarea id="nachricht" name="nachricht" rows="6" required></textarea>
            </div>
            <div class="full">
              <button type="submit" class="btn btn--amber">Nachricht senden</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media(max-width:768px) {
    [style*="grid-template-columns:1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
