---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import standorte from '../data/standorte.json';
import PageHeader from '../components/PageHeader.astro';
import Reveal from '../components/Reveal.tsx';

const woerth = standorte.find((s: any) => s.id === 'woerth')!;
const details = [
  { label: 'Adresse', value: `${woerth.address}, ${woerth.zip} ${woerth.city}` },
  { label: 'Telefon', value: site.phone, href: `tel:${site.phonePlain}` },
  { label: 'E-Mail', value: site.email, href: `mailto:${site.email}` },
  { label: 'Fax', value: site.fax },
];
const inputCls = 'w-full rounded-btn border border-line bg-white px-3.5 py-3 font-sans text-[14px] font-light text-ink transition-colors focus:border-gold focus:outline-none';
const labelCls = 'mb-2 block font-sans text-[10px] font-semibold uppercase tracking-label text-ink-mid';
---
<Layout
  title="Kontakt – med.vital"
  description="Nehmen Sie Kontakt auf und vereinbaren Sie Ihren Termin bei med.vital in Wörth am Main."
>
  <PageHeader eyebrow="Kontakt" title="Wir sind für Sie da" sub="Rufen Sie an, schreiben Sie uns oder nutzen Sie das Kontaktformular." />

  <section class="section">
    <div class="container">
      <Reveal client:visible>
        <div class="grid gap-14 md:grid-cols-2">
          {/* Details */}
          <div>
            <span class="eyebrow mb-5">Erreichbarkeit</span>
            <h2 class="font-serif text-h2 text-ink">Kontaktdaten</h2>
            <dl class="mt-8 divide-y divide-line border-y border-line">
              {details.map((d) => (
                <div class="grid grid-cols-[100px_1fr] gap-4 py-4">
                  <dt class="font-sans text-[10px] font-semibold uppercase tracking-label text-ink-lt">{d.label}</dt>
                  <dd class="font-sans text-[15px] font-light text-ink-mid">
                    {d.href ? <a class="transition-colors hover:text-gold" href={d.href}>{d.value}</a> : d.value}
                  </dd>
                </div>
              ))}
            </dl>

            <h3 class="mt-10 font-serif text-2xl text-ink">Öffnungszeiten</h3>
            <table class="mt-4 w-full border-collapse">
              {site.hours.map((h: any) => (
                <tr class="border-b border-line">
                  <td class="py-3 font-serif text-base text-ink">{h.days}</td>
                  <td class="py-3 text-right font-sans text-[14px] font-light text-ink-mid">{h.time}</td>
                </tr>
              ))}
            </table>
          </div>

          {/* Form */}
          <div class="rounded-card border border-line bg-cream-dk p-8 md:p-10">
            <span class="eyebrow mb-5">Nachricht</span>
            <h2 class="font-serif text-[clamp(1.75rem,3vw,2.5rem)] text-ink">Termin anfragen</h2>
            <p class="mt-3 font-sans text-[13px] font-light leading-relaxed text-ink-mid">Füllen Sie das Formular aus und wir melden uns schnellstmöglich.</p>

            <form id="kontaktform" class="mt-7 grid grid-cols-1 gap-5 sm:grid-cols-2" name="kontakt" method="POST">
              <div>
                <label class={labelCls} for="vorname">Vorname *</label>
                <input class={inputCls} type="text" id="vorname" name="vorname" required />
              </div>
              <div>
                <label class={labelCls} for="nachname">Nachname *</label>
                <input class={inputCls} type="text" id="nachname" name="nachname" required />
              </div>
              <div class="sm:col-span-2">
                <label class={labelCls} for="email">E-Mail *</label>
                <input class={inputCls} type="email" id="email" name="email" required />
              </div>
              <div class="sm:col-span-2">
                <label class={labelCls} for="telefon">Telefon</label>
                <input class={inputCls} type="tel" id="telefon" name="telefon" />
              </div>
              <div class="sm:col-span-2">
                <label class={labelCls} for="betreff">Betreff</label>
                <select class={inputCls} id="betreff" name="betreff">
                  <option value="">Bitte wählen</option>
                  <option value="termin">Terminanfrage</option>
                  <option value="rezept">Rezeptfrage</option>
                  <option value="sonstiges">Sonstiges</option>
                </select>
              </div>
              <div class="sm:col-span-2">
                <label class={labelCls} for="nachricht">Ihre Nachricht *</label>
                <textarea class={`${inputCls} min-h-[120px] resize-y`} id="nachricht" name="nachricht" rows="5" required></textarea>
              </div>
              <div class="sm:col-span-2">
                <button type="submit" class="w-full rounded-btn bg-gold px-8 py-4 font-sans text-[11px] font-semibold uppercase tracking-label text-white transition-colors hover:bg-gold-dk">Nachricht senden</button>
              </div>
            </form>
          </div>
        </div>
      </Reveal>

      <div class="mt-14 overflow-hidden rounded-card border border-line">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2575.5420883050356!2d9.153425276518748!3d49.794675571474464!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47bd51b3e16e1c65%3A0xadef57eea0596f9b!2sPfarrer-Adam-Haus-Stra%C3%9Fe%205A%2C%2063939%20W%C3%B6rth%20am%20Main!5e0!3m2!1sde!2sde!4v1776924491518!5m2!1sde!2sde"
          width="100%"
          height="360"
          style="border:0;filter:grayscale(0.35) contrast(0.97);"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="med.vital — Pfarrer-Adam-Haus-Str. 5a, 63939 Wörth am Main">
        </iframe>
      </div>
    </div>
  </section>

  <!-- Functional fallback: opens the visitor's mail client with the form prefilled.
       Swap for a real handler (Formspree / Cloudflare Pages Function) when available. -->
  <script define:vars={{ email: site.email }}>
    (function () {
      var form = document.getElementById('kontaktform');
      if (!form) return;
      var labels = { termin: 'Terminanfrage', rezept: 'Rezeptfrage', sonstiges: 'Sonstiges' };
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var d = new FormData(form);
        var g = function (k) { return (d.get(k) || '').toString().trim(); };
        var betreff = labels[g('betreff')] || 'Kontaktanfrage';
        var subject = (betreff + ' – ' + g('vorname') + ' ' + g('nachname')).trim();
        var body = [
          'Name: ' + g('vorname') + ' ' + g('nachname'),
          'E-Mail: ' + g('email'),
          'Telefon: ' + g('telefon'),
          'Betreff: ' + betreff,
          '',
          g('nachricht'),
        ].join('\n');
        window.location.href = 'mailto:' + email + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      });
    })();
  </script>
</Layout>
