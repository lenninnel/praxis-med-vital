---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import standorte from '../data/standorte.json';

const woerth = standorte.find((s: any) => s.id === 'woerth');
---

<Layout title="Kontakt – Praxis Med Vital" description="Nehmen Sie Kontakt auf und vereinbaren Sie Ihren Termin bei Praxis Med Vital.">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Kontakt</span>
      <h1>Wir sind für Sie da</h1>
      <p>Rufen Sie an, schreiben Sie uns oder nutzen Sie das Kontaktformular.</p>
    </div>
  </section>

  <section class="sec sec--cream reveal">
    <div class="container">
      <div class="contact-grid">
        <div>
          <span class="eyebrow">Erreichbarkeit</span>
          <h2 class="section-title">Kontaktdaten</h2>

          <div style="margin-top:36px">
            <div class="contact-detail">
              <div class="contact-detail__icon">A</div>
              <div class="contact-detail__text">
                <h4>Adresse</h4>
                <p>{woerth?.address}<br/>{woerth?.zip} {woerth?.city}</p>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail__icon">T</div>
              <div class="contact-detail__text">
                <h4>Telefon</h4>
                <p><a href={`tel:${site.phonePlain}`}>{site.phone}</a></p>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail__icon">@</div>
              <div class="contact-detail__text">
                <h4>E-Mail</h4>
                <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail__icon">F</div>
              <div class="contact-detail__text">
                <h4>Fax</h4>
                <p>{site.fax}</p>
              </div>
            </div>
          </div>

          <h3 style="font-family:var(--ff-serif);font-style:italic;font-size:22px;font-weight:400;margin-top:48px;margin-bottom:8px;color:var(--ink)">Öffnungszeiten</h3>
          <table class="hours-table">
            {site.hours.map((h: any) => (
              <tr>
                <td>{h.days}</td>
                <td>{h.time}</td>
              </tr>
            ))}
          </table>
        </div>

        <div class="contact-form-wrap">
          <span class="eyebrow">Nachricht</span>
          <h2 class="section-title" style="font-size:clamp(28px,3vw,40px)">Termin anfragen</h2>
          <p style="font-family:var(--ff-sans);font-size:13px;font-weight:300;color:var(--ink-mid);margin:18px 0 28px;line-height:1.7">
            Füllen Sie das Formular aus und wir melden uns schnellstmöglich.
          </p>
          <form class="contact-form" name="kontakt" method="POST" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="kontakt" />
            <p class="full" style="display:none">
              <label>Nicht ausfüllen: <input name="bot-field" /></label>
            </p>
            <div class="form-group">
              <label for="vorname">Vorname *</label>
              <input type="text" id="vorname" name="vorname" required />
            </div>
            <div class="form-group">
              <label for="nachname">Nachname *</label>
              <input type="text" id="nachname" name="nachname" required />
            </div>
            <div class="form-group full">
              <label for="email">E-Mail *</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group full">
              <label for="telefon">Telefon</label>
              <input type="tel" id="telefon" name="telefon" />
            </div>
            <div class="form-group full">
              <label for="betreff">Betreff</label>
              <select id="betreff" name="betreff">
                <option value="">Bitte wählen</option>
                <option value="termin">Terminanfrage</option>
                <option value="rezept">Rezeptfrage</option>
                <option value="sonstiges">Sonstiges</option>
              </select>
            </div>
            <div class="form-group full">
              <label for="nachricht">Ihre Nachricht *</label>
              <textarea id="nachricht" name="nachricht" rows="5" required></textarea>
            </div>
            <div class="full">
              <button type="submit" class="btn-primary">Nachricht senden</button>
            </div>
          </form>
        </div>
      </div>

      <div style="width:100%;height:340px;overflow:hidden;margin-top:56px;border:0.5px solid var(--border);">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2575.5420883050356!2d9.153425276518748!3d49.794675571474464!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47bd51b3e16e1c65%3A0xadef57eea0596f9b!2sPfarrer-Adam-Haus-Stra%C3%9Fe%205A%2C%2063939%20W%C3%B6rth%20am%20Main!5e0!3m2!1sde!2sde!4v1776924491518!5m2!1sde!2sde"
          width="100%"
          height="340"
          style="border:0;filter:grayscale(0.4) contrast(0.95);"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Praxis Med Vital — Pfarrer-Adam-Haus-Str. 5a, 63939 Wörth am Main">
        </iframe>
      </div>
    </div>
  </section>
</Layout>
