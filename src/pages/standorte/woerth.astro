---
import Layout from '../../layouts/Layout.astro';
import standorte from '../../data/standorte.json';

const standort = standorte.find((s: any) => s.id === 'woerth')!;
---

<Layout title="Standort Wörth am Main – Praxis Med Vital" description="Unsere Praxis in Wörth am Main: Adresse, Öffnungszeiten und Anfahrt.">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Standort</span>
      <h1>{standort.name}</h1>
      <p>{standort.address}, {standort.zip} {standort.city}</p>
    </div>
  </section>

  <section class="sec sec--cream reveal">
    <div class="container">
      <a href="/standorte" class="back-link" style="margin-bottom:40px">← Alle Standorte</a>
      <div class="standort-info" style="margin-top:24px">
        <div>
          <span class="eyebrow">Vor Ort</span>
          <h2 class="section-title">Kontakt &amp; Adresse</h2>

          <div style="margin-top:36px">
            <div class="contact-detail">
              <div class="contact-detail__icon">A</div>
              <div class="contact-detail__text">
                <h4>Adresse</h4>
                <p>{standort.address}<br/>{standort.zip} {standort.city}</p>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail__icon">T</div>
              <div class="contact-detail__text">
                <h4>Telefon</h4>
                <p><a href={`tel:${standort.phonePlain}`}>{standort.phone}</a></p>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail__icon">@</div>
              <div class="contact-detail__text">
                <h4>E-Mail</h4>
                <p><a href={`mailto:${standort.email}`}>{standort.email}</a></p>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail__icon">P</div>
              <div class="contact-detail__text">
                <h4>Parkplätze</h4>
                <p>{standort.parking}</p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <span class="eyebrow">Zeiten</span>
          <h2 class="section-title">Öffnungszeiten</h2>
          <table class="hours-table" style="margin-top:24px">
            {standort.hours.map((h: any) => (
              <tr>
                <td>{h.days}</td>
                <td>{h.time}</td>
              </tr>
            ))}
          </table>
          <a href="/kontakt" class="btn-primary" style="margin-top:36px">Termin anfragen</a>
        </div>
      </div>

      <div style="width:100%;height:340px;overflow:hidden;margin-top:56px;border:0.5px solid var(--border);">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2575.5420883050356!2d9.153425276518748!3d49.794675571474464!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47bd51b3e16e1c65%3A0xadef57eea0596f9b!2sPfarrer-Adam-Haus-Stra%C3%9Fe%205A%2C%2063939%20W%C3%B6rth%20am%20Main!5e0!3m2!1sde!2sde!4v1776924491518!5m2!1sde!2sde"
          width="100%"
          height="340"
          style="border:0;filter:grayscale(0.4) contrast(0.95);"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Praxis Med Vital — Pfarrer-Adam-Haus-Str. 5a, 63939 Wörth am Main">
        </iframe>
      </div>
    </div>
  </section>
</Layout>
