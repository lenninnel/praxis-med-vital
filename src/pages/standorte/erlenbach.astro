---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Reveal from '../../components/Reveal.tsx';
import { withBase } from '../../lib/base';
---
<Layout
  title="Erlenbach am Main – med.vital"
  description="Unser neuer Standort in Erlenbach am Main — demnächst verfügbar."
>
  <PageHeader eyebrow="Standort" title="Erlenbach am Main" sub="Unser zweiter Standort — demnächst für Sie da." />

  <section class="section">
    <div class="container">
      <a href={withBase('/standorte')} class="inline-flex items-center gap-2 font-sans text-[11px] font-semibold uppercase tracking-label text-ink-lt transition-colors hover:text-ink">← Alle Standorte</a>

      <Reveal client:visible>
        <div class="mx-auto mt-12 flex max-w-xl flex-col items-center rounded-card border border-line bg-cream-dk px-8 py-20 text-center">
          <span class="rounded-pill border border-gold px-4 py-1.5 font-sans text-[10px] font-semibold uppercase tracking-label text-gold">Bald verfügbar</span>
          <h2 class="mt-7 font-serif text-h2 text-ink">Wir expandieren</h2>
          <p class="lede mx-auto mt-4">
            Unser neuer Standort in Erlenbach am Main ist in Vorbereitung. Wir informieren Sie
            gerne, sobald es Neuigkeiten gibt.
          </p>
          <div class="mt-9 flex flex-wrap items-center justify-center gap-6">
            <a href={withBase('/kontakt')} class="rounded-btn bg-gold px-8 py-4 font-sans text-[11px] font-semibold uppercase tracking-label text-white transition-colors hover:bg-gold-dk">Benachrichtigung anfragen</a>
            <a href={withBase('/standorte/woerth')} class="border-b border-gold pb-1 font-sans text-[11px] font-semibold uppercase tracking-label text-ink transition-colors hover:text-gold">Standort Wörth →</a>
          </div>
        </div>
      </Reveal>
    </div>
  </section>
</Layout>
