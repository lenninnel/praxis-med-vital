---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Erlenbach am Main – Praxis Med Vital" description="Unser neuer Standort in Erlenbach am Main — demnächst verfügbar.">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Standort</span>
      <h1>Erlenbach am Main</h1>
      <p>Unser zweiter Standort — demnächst für Sie da.</p>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="coming-soon reveal">
        <span class="coming-soon__badge">Coming Soon</span>
        <h2>Wir expandieren!</h2>
        <p>
          Unser neuer Standort in Erlenbach am Main befindet sich in Vorbereitung.
          Wir informieren Sie gerne, sobald es Neuigkeiten gibt.
        </p>
        <div style="display:flex;gap:16px;flex-wrap:wrap;justify-content:center">
          <a href={`${import.meta.env.BASE_URL}kontakt`} class="btn-primary">Benachrichtigung anfragen</a>
          <a href={`${import.meta.env.BASE_URL}standorte/woerth`} class="btn-ghost btn-ghost--dark">Standort Wörth ansehen →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
