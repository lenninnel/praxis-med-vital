---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Erlenbach am Main – Praxis Med Vital" description="Unser neuer Standort in Erlenbach am Main — demnächst verfügbar.">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Standort</span>
      <h1>Erlenbach am Main</h1>
      <p>Unser zweiter Standort — demnächst für Sie da.</p>
    </div>
  </section>

  <section class="sec sec--cream">
    <div class="container">
      <a href="/standorte" class="back-link" style="margin-bottom:40px">← Alle Standorte</a>
      <div class="coming-soon reveal" style="margin-top:24px">
        <span class="coming-soon__badge">Coming Soon</span>
        <h2>Wir expandieren</h2>
        <p>
          Unser neuer Standort in Erlenbach am Main befindet sich in Vorbereitung.
          Wir informieren Sie gerne, sobald es Neuigkeiten gibt.
        </p>
        <div style="display:flex;gap:32px;flex-wrap:wrap;justify-content:center;align-items:center">
          <a href="/kontakt" class="btn-primary">Benachrichtigung anfragen</a>
          <a href="/standorte/woerth" class="btn-ghost btn-ghost--dark">Standort Wörth ansehen →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
