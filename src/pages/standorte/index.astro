---
import Layout from '../../layouts/Layout.astro';
import standorte from '../../data/standorte.json';
---

<Layout title="Standorte – Praxis Med Vital" description="Unsere Praxisstandorte in Wörth am Main und demnächst in Erlenbach am Main.">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Standorte</span>
      <h1>Unsere Praxen</h1>
      <p>In Ihrer Nähe — persönlich und gut erreichbar.</p>
    </div>
  </section>

  <section class="sec reveal">
    <div class="container">
      <div class="card-grid">
        {standorte.map((s: any) => (
          <div class="standort-card">
            <span class={`standort-card__status standort-card__status--${s.status === 'active' ? 'active' : 'coming-soon'}`}>
              {s.status === 'active' ? 'Geöffnet' : 'Demnächst'}
            </span>
            <h3 style="font-size:26px;margin-bottom:8px">{s.name}</h3>
            {s.address ? (
              <>
                <p style="font-size:14px;font-weight:300;color:var(--ink-mid);margin-bottom:6px">
                  {s.address}<br/>{s.zip} {s.city}
                </p>
                <p style="font-size:14px;font-weight:300;color:var(--ink-mid)">
                  Tel: <a href={`tel:${s.phonePlain}`} style="color:var(--g700)">{s.phone}</a>
                </p>
                <a href={`${import.meta.env.BASE_URL}standorte/${s.id}`} class="btn-ghost btn-ghost--dark" style="margin-top:20px">Details ansehen →</a>
              </>
            ) : (
              <p style="font-size:14px;font-weight:300;color:var(--ink-mid)">
                {s.openingNote}
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
