---
import Layout from '../../layouts/Layout.astro';
import standorte from '../../data/standorte.json';
import PageHeader from '../../components/PageHeader.astro';
import LocationCard from '../../components/LocationCard.astro';
import Reveal from '../../components/Reveal.tsx';
import CtaBand from '../../components/CtaBand.astro';
---
<Layout
  title="Standorte – med.vital"
  description="Unsere Praxisstandorte in Wörth am Main und demnächst in Erlenbach am Main — persönlich und gut erreichbar."
>
  <PageHeader eyebrow="Standorte" title="2× in Ihrer Nähe" sub="Persönliche Therapie im Main-Tal — kurze Wege, vertraute Gesichter." />
  <section class="section">
    <div class="container">
      <Reveal client:visible>
        <div class="grid gap-8 md:grid-cols-2">
          {standorte.map((s: any) => (
            <LocationCard name={s.name} status={s.status} address={s.address} zip={s.zip} city={s.city}
              phone={s.phone} phonePlain={s.phonePlain} email={s.email}
              image={s.id === 'woerth' ? '/img/standort-woerth.png' : null}
              href={`/standorte/${s.id}`} />
          ))}
        </div>
      </Reveal>
    </div>
  </section>
  <CtaBand />
</Layout>
