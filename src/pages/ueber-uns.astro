---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Reveal from '../components/Reveal.tsx';
import CtaBand from '../components/CtaBand.astro';

const werte = [
  { titel: 'Ganzheitlich', text: 'Wir behandeln nicht nur Symptome — wir suchen die Ursache.' },
  { titel: 'Individuell', text: 'Jeder Mensch erhält einen Therapieplan, der auf seine Bedürfnisse abgestimmt ist.' },
  { titel: 'Kompetent', text: 'Staatlich anerkannte Therapeuten mit zertifizierten Spezialmethoden.' },
];
---
<Layout
  title="Über uns – med.vital"
  description="Unsere Philosophie: ganzheitliche Therapie, Training und Coaching in Wörth am Main. Ihre Alltagsmobilität steht bei uns an erster Stelle."
>
  <PageHeader eyebrow="Über die Praxis" title="Unsere Philosophie" sub="Ganzheitliche Therapie in Wörth am Main — seit über 15 Jahren." />

  <section class="section">
    <div class="container max-w-[760px]">
      <Reveal client:visible>
        <p class="border-l border-gold pl-6 font-serif text-[clamp(1.5rem,2.8vw,2rem)] italic leading-snug text-ink">
          Wenn Sie den Bedarf sehen, Ihre körperlichen Beeinträchtigungen mit einer Vielzahl an
          Therapien zu verbessern, dann sind Sie bei uns genau richtig.
        </p>
        <p class="lede mt-8 text-[16px]">
          Wir untersuchen Sie, wir behandeln Sie und wir trainieren Sie. Mit unserem besonders
          gelenkschonenden orthopädisch-koordinativen Trainingszirkel können wir auch intensiver
          behandeln — selbst starke Einschränkungen lassen sich hier trainieren.
        </p>
        <p class="mt-8 font-serif text-2xl italic text-ink">Ihre Alltagsmobilität steht bei uns an erster Stelle.</p>
      </Reveal>
    </div>
  </section>

  <section class="section bg-cream-dk">
    <div class="container">
      <Reveal client:visible>
        <div class="text-center">
          <span class="eyebrow eyebrow--center mb-5">Was uns leitet</span>
          <h2 class="font-serif text-h2 text-ink">Unsere Werte</h2>
        </div>
        <div class="mx-auto mt-14 grid max-w-4xl gap-px overflow-hidden rounded-card border border-line bg-line md:grid-cols-3">
          {werte.map((w) => (
            <div class="bg-cream p-10">
              <h3 class="font-serif text-2xl text-ink">{w.titel}</h3>
              <p class="mt-3 font-sans text-[14px] font-light leading-relaxed text-ink-mid">{w.text}</p>
            </div>
          ))}
        </div>
      </Reveal>
    </div>
  </section>

  <CtaBand title="Bereit für Ihren ersten Termin?" />
</Layout>
