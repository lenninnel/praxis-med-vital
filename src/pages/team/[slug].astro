---
import Layout from '../../layouts/Layout.astro';
import team from '../../data/team.json';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import Reveal from '../../components/Reveal.tsx';
import CtaBand from '../../components/CtaBand.astro';
import { withBase } from '../../lib/base';

export function getStaticPaths() {
  return team.map((m: any) => ({ params: { slug: m.id }, props: { member: m } }));
}
const { member } = Astro.props;
const paras = (member.bioLong || member.bio || '').split('\n\n');
---
<Layout title={`${member.name} – med.vital`} description={member.bio}>
  <section class="section">
    <div class="container">
      <a href={withBase('/team')} class="inline-flex items-center gap-2 font-sans text-[11px] font-semibold uppercase tracking-label text-ink-lt transition-colors hover:text-ink">← Zum Team</a>

      <div class="mt-8 grid gap-12 md:grid-cols-[0.8fr_1.2fr] md:items-start">
        <Reveal client:load>
          <div class="overflow-hidden rounded-card border border-line bg-cream-dk">
            <ImagePlaceholder src={member.photo} ratio="4 / 5" rounded={false} label={member.initials} sublabel="Porträt folgt" alt={member.name} />
          </div>
        </Reveal>

        <Reveal client:load>
          <h1 class="font-serif text-display text-ink">{member.name}</h1>
          <p class="mt-2 font-sans text-[11px] font-semibold uppercase tracking-label text-gold">
            {member.qualification ? member.qualification + ' · ' : ''}{member.role}
          </p>

          {member.credentials && member.credentials.length > 0 && (
            <ul class="mt-7 space-y-2.5">
              {member.credentials.map((c: string) => (
                <li class="relative pl-6 font-sans text-[14px] font-light text-ink-mid">
                  <span class="absolute left-0 top-[0.7em] h-px w-3.5 bg-gold"></span>{c}
                </li>
              ))}
            </ul>
          )}

          <div class="mt-8 max-w-prose space-y-4">
            {paras.map((p: string) => (
              <p class="font-sans text-[15px] font-light leading-[1.8] text-ink-mid">{p}</p>
            ))}
          </div>

          {member.tags && member.tags.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-1.5">
              {member.tags.map((t: string) => (
                <span class="rounded-pill border border-parchment px-2.5 py-1 font-sans text-[9px] font-medium uppercase tracking-[0.1em] text-ink-mid">{t}</span>
              ))}
            </div>
          )}
        </Reveal>
      </div>
    </div>
  </section>
  <CtaBand />
</Layout>
