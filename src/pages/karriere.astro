---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';

const vorteile = [
  {
    titel: 'Zwei Standorte',
    text: 'Wörth am Main und bald Erlenbach — Entwicklungsmöglichkeiten an beiden Standorten.',
  },
  {
    titel: 'Spezialisierung',
    text: 'Wir fördern Fortbildungen in Applied Kinesiology, Cranio Concept, Mulligan und weiteren Spezialmethoden.',
  },
  {
    titel: 'Team',
    text: 'Kleine Praxis, echtes Miteinander — drei Inhaber die selbst behandeln und immer ansprechbar sind.',
  },
];

const stellen = [
  {
    titel: 'Physiotherapeut/in (m/w/d)',
    ort: 'Wörth am Main',
    art: 'Voll- oder Teilzeit',
    text: 'Sie behandeln eigenverantwortlich ein breites Patientenspektrum und bringen idealerweise Interesse an Spezialmethoden mit.',
    cta: 'Jetzt bewerben',
    href: `mailto:${site.email}?subject=${encodeURIComponent('Bewerbung Physiotherapeut/in')}`,
  },
  {
    titel: 'Initiativbewerbung',
    ort: 'Wörth am Main · Erlenbach am Main',
    art: 'Alle Qualifikationen willkommen',
    text: 'Sie finden keine passende Stelle? Schicken Sie uns trotzdem Ihre Unterlagen — wir freuen uns über engagierte Menschen, die zu uns passen.',
    cta: 'Initiativ bewerben',
    href: `mailto:${site.email}?subject=${encodeURIComponent('Initiativbewerbung Med Vital')}`,
  },
];
---

<Layout title="Karriere – Praxis Med Vital" description="Werde Teil unseres Teams. Offene Stellen und Initiativbewerbungen in der Praxis Med Vital — Wörth am Main und Erlenbach am Main.">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Karriere</span>
      <h1>Werde Teil unseres Teams</h1>
      <p>Wir wachsen — und suchen Menschen, die Physiotherapie genauso lieben wie wir.</p>
    </div>
  </section>

  <section class="sec sec--cream reveal">
    <div class="container">
      <div class="text-center" style="margin-bottom:56px">
        <span class="eyebrow">Warum Med Vital</span>
        <h2 class="section-title">Was uns ausmacht</h2>
      </div>
      <div class="vorteile-grid">
        {vorteile.map((v) => (
          <div class="vorteil-card">
            <h3 class="vorteil-card__titel">{v.titel}</h3>
            <p class="vorteil-card__text">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--white reveal">
    <div class="container">
      <div class="text-center" style="margin-bottom:56px">
        <span class="eyebrow">Offene Stellen</span>
        <h2 class="section-title">Aktuell suchen wir</h2>
      </div>
      <div class="stellen-grid">
        {stellen.map((s) => (
          <article class="stelle-card">
            <h3 class="stelle-card__titel">{s.titel}</h3>
            <div class="stelle-card__meta">
              <span class="stelle-card__tag">{s.ort}</span>
              <span class="stelle-card__tag">{s.art}</span>
            </div>
            <p class="stelle-card__text">{s.text}</p>
            <a href={s.href} class="btn-primary stelle-card__cta">{s.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--ink reveal">
    <div class="container text-center">
      <span class="eyebrow">Persönlich</span>
      <h2 class="section-title">Fragen zur Stelle?</h2>
      <p class="section-sub">
        Sprechen Sie uns einfach an — Sven, Chris oder Kai sind persönlich erreichbar.
      </p>
      <a href={`tel:${site.phonePlain}`} class="btn-primary" style="margin-top:36px">{site.phone}</a>
    </div>
  </section>
</Layout>

<style>
  .vorteile-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    max-width: 1000px;
    margin: 0 auto;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .vorteil-card {
    background: var(--cream);
    padding: 48px 36px;
    transition: background .3s;
  }
  .vorteil-card:hover { background: var(--white); }

  .vorteil-card__titel {
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: 26px;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: 12px;
    line-height: 1.2;
  }

  .vorteil-card__text {
    font-family: var(--ff-sans);
    font-size: 14px;
    font-weight: 300;
    color: var(--ink-mid);
    line-height: 1.7;
  }

  .stellen-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    max-width: 960px;
    margin: 0 auto;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .stelle-card {
    background: var(--cream);
    padding: 48px 44px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    transition: background .3s;
  }
  .stelle-card:hover { background: var(--white); }

  .stelle-card__titel {
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: 28px;
    font-weight: 400;
    color: var(--ink);
    line-height: 1.15;
  }

  .stelle-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stelle-card__tag {
    display: inline-block;
    padding: 5px 12px;
    background: transparent;
    border: 0.5px solid var(--parchment);
    border-radius: 0;
    font-family: var(--ff-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--ink-mid);
  }

  .stelle-card__text {
    font-family: var(--ff-sans);
    font-size: 14px;
    font-weight: 300;
    color: var(--ink-mid);
    line-height: 1.75;
  }

  .stelle-card__cta {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (max-width: 860px) {
    .vorteile-grid,
    .stellen-grid { grid-template-columns: 1fr; }
    .stelle-card { padding: 36px 32px; }
  }
</style>
