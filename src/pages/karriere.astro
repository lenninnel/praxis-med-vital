---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import PageHeader from '../components/PageHeader.astro';
import Reveal from '../components/Reveal.tsx';

const vorteile = [
  { titel: 'Zwei Standorte', text: 'Wörth am Main und bald Erlenbach — Entwicklungsmöglichkeiten an beiden Standorten.' },
  { titel: 'Spezialisierung', text: 'Wir fördern Fortbildungen in Applied Kinesiology, Cranio Concept, Mulligan und weiteren Methoden.' },
  { titel: 'Echtes Team', text: 'Kleine Praxis, echtes Miteinander — drei Inhaber, die selbst behandeln und immer ansprechbar sind.' },
];

const stellen = [
  {
    titel: 'Physiotherapeut/in (m/w/d)',
    ort: 'Wörth am Main',
    art: 'Voll- oder Teilzeit',
    text: 'Sie behandeln eigenverantwortlich ein breites Patientenspektrum und bringen idealerweise Interesse an Spezialmethoden mit.',
    cta: 'Jetzt bewerben',
    href: `mailto:${site.email}?subject=${encodeURIComponent('Bewerbung Physiotherapeut/in')}`,
  },
  {
    titel: 'Initiativbewerbung',
    ort: 'Wörth · Erlenbach',
    art: 'Alle Qualifikationen willkommen',
    text: 'Sie finden keine passende Stelle? Schicken Sie uns trotzdem Ihre Unterlagen — wir freuen uns über engagierte Menschen, die zu uns passen.',
    cta: 'Initiativ bewerben',
    href: `mailto:${site.email}?subject=${encodeURIComponent('Initiativbewerbung med.vital')}`,
  },
];
---
<Layout
  title="Karriere – med.vital"
  description="Werde Teil unseres Teams. Offene Stellen und Initiativbewerbungen bei med.vital — Wörth am Main und Erlenbach."
>
  <PageHeader eyebrow="Karriere" title="Werde Teil unseres Teams" sub="Wir wachsen — und suchen Menschen, die Therapie genauso lieben wie wir." />

  <section class="section">
    <div class="container">
      <Reveal client:visible>
        <div class="text-center">
          <span class="eyebrow eyebrow--center mb-5">Warum med.vital</span>
          <h2 class="font-serif text-h2 text-ink">Was uns ausmacht</h2>
        </div>
        <div class="mx-auto mt-14 grid max-w-4xl gap-px overflow-hidden rounded-card border border-line bg-line md:grid-cols-3">
          {vorteile.map((v) => (
            <div class="bg-cream p-10">
              <h3 class="font-serif text-2xl text-ink">{v.titel}</h3>
              <p class="mt-3 font-sans text-[14px] font-light leading-relaxed text-ink-mid">{v.text}</p>
            </div>
          ))}
        </div>
      </Reveal>
    </div>
  </section>

  <section class="section bg-cream-dk">
    <div class="container">
      <Reveal client:visible>
        <div class="text-center">
          <span class="eyebrow eyebrow--center mb-5">Offene Stellen</span>
          <h2 class="font-serif text-h2 text-ink">Aktuell suchen wir</h2>
        </div>
        <div class="mx-auto mt-14 grid max-w-4xl gap-8 md:grid-cols-2">
          {stellen.map((s) => (
            <article class="flex flex-col gap-5 rounded-card border border-line bg-cream p-10">
              <h3 class="font-serif text-[26px] leading-tight text-ink">{s.titel}</h3>
              <div class="flex flex-wrap gap-2">
                <span class="rounded-pill border border-parchment px-3 py-1 font-sans text-[9px] font-medium uppercase tracking-label text-ink-mid">{s.ort}</span>
                <span class="rounded-pill border border-parchment px-3 py-1 font-sans text-[9px] font-medium uppercase tracking-label text-ink-mid">{s.art}</span>
              </div>
              <p class="font-sans text-[14px] font-light leading-relaxed text-ink-mid">{s.text}</p>
              <a href={s.href} class="mt-auto inline-flex w-fit rounded-btn bg-gold px-7 py-3.5 font-sans text-[11px] font-semibold uppercase tracking-label text-white transition-colors hover:bg-gold-dk">{s.cta}</a>
            </article>
          ))}
        </div>
      </Reveal>
    </div>
  </section>

  <section class="bg-sage px-[8%] py-24 text-center">
    <Reveal client:visible>
      <span class="eyebrow eyebrow--center mb-5 !text-cream/50">Persönlich</span>
      <h2 class="font-serif text-h2 text-cream/95">Fragen zur Stelle?</h2>
      <p class="mx-auto mt-4 max-w-md font-sans text-[15px] font-light text-cream/55">Sprechen Sie uns einfach an — Sven, Chris oder Kai sind persönlich erreichbar.</p>
      <a href={`tel:${site.phonePlain}`} class="mt-8 inline-flex rounded-btn bg-cream px-8 py-4 font-sans text-[11px] font-semibold uppercase tracking-label text-ink transition-colors hover:bg-white">{site.phone}</a>
    </Reveal>
  </section>
</Layout>
