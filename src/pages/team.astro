---
import Layout from '../layouts/Layout.astro';
import team from '../data/team.json';
import PageHeader from '../components/PageHeader.astro';
import TeamCard from '../components/TeamCard.astro';
import Reveal from '../components/Reveal.tsx';
import CtaBand from '../components/CtaBand.astro';
---
<Layout
  title="Team – med.vital"
  description="Drei erfahrene Therapeuten mit unterschiedlichen Spezialisierungen — für eine umfassende Versorgung in Wörth am Main."
>
  <PageHeader
    eyebrow="Unser Team"
    title="Kompetenz trifft Leidenschaft"
    sub="Drei erfahrene Therapeuten mit unterschiedlichen Spezialisierungen — für eine umfassende Versorgung."
  />
  <section class="section">
    <div class="container">
      <Reveal client:visible>
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {team.map((m: any) => (
            <TeamCard id={m.id} name={m.name} role={m.role} qualification={m.qualification}
              bio={m.bio} tags={m.tags} initials={m.initials} photo={m.photo} />
          ))}
        </div>
      </Reveal>
    </div>
  </section>
  <CtaBand />
</Layout>
